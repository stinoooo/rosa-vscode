{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GLSL",
  "scopeName": "source.glsl",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#extra-0"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#type"
    },
    {
      "include": "#builtin"
    },
    {
      "include": "#constant-caps"
    },
    {
      "include": "#type-name"
    },
    {
      "include": "#call"
    },
    {
      "include": "#member"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment-block": {
      "name": "comment.block.glsl",
      "begin": "/\\*",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.glsl"
        }
      },
      "end": "\\*/",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.glsl"
        }
      },
      "patterns": [
        {
          "include": "#todo"
        }
      ]
    },
    "todo": {
      "name": "keyword.other.todo.glsl",
      "match": "\\b(?:TODO|FIXME|HACK|NOTE|XXX|BUG)\\b"
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.block.documentation.glsl",
          "begin": "/\\*\\*(?!/)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.glsl"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.glsl"
            }
          },
          "patterns": [
            {
              "name": "keyword.other.documentation.glsl",
              "match": "@[A-Za-z]+"
            },
            {
              "include": "#todo"
            }
          ]
        },
        {
          "include": "#comment-block"
        },
        {
          "name": "comment.line.glsl",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.glsl"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#todo"
            }
          ]
        }
      ]
    },
    "preprocessor": {
      "name": "meta.preprocessor.glsl",
      "begin": "^\\s*(#)\\s*(\\w+)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.directive.glsl"
        },
        "2": {
          "name": "keyword.control.directive.glsl"
        }
      },
      "end": "(?<!\\\\)$",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#number"
        }
      ]
    },
    "extra-0": {
      "name": "support.variable.builtin.glsl",
      "match": "\\bgl_\\w+\\b"
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.glsl",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.glsl"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.glsl"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.glsl",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            }
          ]
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.glsl",
          "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.binary.glsl",
          "match": "\\b0[bB][01][01_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.octal.glsl",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.glsl",
          "match": "(?:\\b\\d[\\d_]*\\.\\d[\\d_]*|\\B\\.\\d[\\d_]*)(?:[eE][+-]?\\d+)?(?:[fFdDhH]|f16|f32|f64)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d+(?:[fFdD])?\\b"
        },
        {
          "name": "constant.numeric.integer.glsl",
          "match": "\\b\\d[\\d_]*(?:[uUlLnfFdDiI]\\w*)?\\b"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.glsl",
          "match": "\\b(?:if|else|for|while|do|switch|case|default|break|continue|return|discard|demote|terminateInvocation)\\b"
        },
        {
          "name": "storage.type.glsl",
          "match": "\\b(?:struct|layout|subroutine)\\b"
        },
        {
          "name": "storage.modifier.glsl",
          "match": "\\b(?:uniform|buffer|shared|attribute|varying|const|in|out|inout|flat|smooth|noperspective|centroid|sample|patch|invariant|precise|lowp|mediump|highp|precision|coherent|volatile|restrict|readonly|writeonly)\\b"
        },
        {
          "name": "constant.language.glsl",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "name": "support.type.glsl",
          "match": "\\b(?:void|bool|int|uint|float|double)\\b"
        },
        {
          "name": "support.type.glsl",
          "match": "\\b(?:[biud]?vec[234]|d?mat[234](?:x[234])?|[iu]?(?:sampler|image|texture)(?:[123]D|Cube|2DRect|Buffer)(?:MS)?(?:Array)?(?:Shadow)?|sampler(?:Shadow)?|atomic_uint|accelerationStructureEXT|rayQueryEXT)\\b"
        }
      ]
    },
    "builtin": {
      "match": "\\b(radians|degrees|sin|cos|tan|asin|acos|atan|sinh|cosh|tanh|pow|exp|log|exp2|log2|sqrt|inversesqrt|abs|sign|floor|trunc|round|roundEven|ceil|fract|mod|modf|min|max|clamp|mix|step|smoothstep|fma|length|distance|dot|cross|normalize|reflect|refract|faceforward|transpose|determinant|inverse|texture|textureLod|textureGrad|textureSize|texelFetch|textureGather|imageLoad|imageStore|imageSize|dFdx|dFdy|fwidth|barrier|memoryBarrier|atomicAdd|atomicMin|atomicMax|traceRayEXT|reportIntersectionEXT|EmitVertex|EndPrimitive)\\b(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "support.function.builtin.glsl"
        }
      }
    },
    "constant-caps": {
      "name": "constant.other.caps.glsl",
      "match": "\\b[A-Z][A-Z0-9_]*[A-Z0-9]\\b(?![a-z(])"
    },
    "type-name": {
      "name": "entity.name.type.glsl",
      "match": "\\b[A-Z][A-Za-z0-9_]*[a-z][A-Za-z0-9_]*\\b"
    },
    "call": {
      "match": "\\b([A-Za-z_][\\w!?]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.glsl"
        }
      }
    },
    "member": {
      "match": "(\\.)\\s*([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.glsl"
        },
        "2": {
          "name": "variable.other.property.glsl"
        }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.glsl",
          "match": "=>|->|<-|\\|>"
        },
        {
          "name": "keyword.operator.comparison.glsl",
          "match": "===|!==|==|!=|<=|>="
        },
        {
          "name": "keyword.operator.assignment.glsl",
          "match": "(?:\\+|-|\\*|/|%|&|\\||\\^|<<|>>|\\?\\?)?=(?![=>])|:="
        },
        {
          "name": "keyword.operator.logical.glsl",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.range.glsl",
          "match": "\\.\\.[.<=]?"
        },
        {
          "name": "keyword.operator.arithmetic.glsl",
          "match": "\\*\\*|\\+\\+|--|[-+*/%]"
        },
        {
          "name": "keyword.operator.bitwise.glsl",
          "match": "<<|>>|[&|^~]"
        },
        {
          "name": "keyword.operator.comparison.glsl",
          "match": "[<>]"
        },
        {
          "name": "keyword.operator.glsl",
          "match": "\\?|::|:|@"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.glsl"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.glsl"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.glsl",
          "match": ";"
        },
        {
          "name": "punctuation.separator.glsl",
          "match": ","
        },
        {
          "name": "punctuation.section.brackets.glsl",
          "match": "[()\\[\\]{}]"
        }
      ]
    }
  }
}
