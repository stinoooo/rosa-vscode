{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kotlin",
  "scopeName": "source.kotlin",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#annotation"
    },
    {
      "include": "#function-definition"
    },
    {
      "include": "#type-definition"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#type"
    },
    {
      "include": "#builtin"
    },
    {
      "include": "#constant-caps"
    },
    {
      "include": "#type-name"
    },
    {
      "include": "#call"
    },
    {
      "include": "#member"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment-block": {
      "name": "comment.block.kotlin",
      "begin": "/\\*",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.kotlin"
        }
      },
      "end": "\\*/",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.kotlin"
        }
      },
      "patterns": [
        {
          "include": "#todo"
        },
        {
          "include": "#comment-block"
        }
      ]
    },
    "todo": {
      "name": "keyword.other.todo.kotlin",
      "match": "\\b(?:TODO|FIXME|HACK|NOTE|XXX|BUG)\\b"
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.block.documentation.kotlin",
          "begin": "/\\*\\*(?!/)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.kotlin"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.kotlin"
            }
          },
          "patterns": [
            {
              "name": "keyword.other.documentation.kotlin",
              "match": "@[A-Za-z]+"
            },
            {
              "include": "#todo"
            }
          ]
        },
        {
          "include": "#comment-block"
        },
        {
          "name": "comment.line.kotlin",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.kotlin"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#todo"
            }
          ]
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.triple.kotlin",
          "begin": "\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.kotlin"
            }
          },
          "end": "\"\"\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.kotlin"
            }
          },
          "patterns": [
            {
              "name": "meta.embedded.interpolation.kotlin",
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.kotlin"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.kotlin"
                }
              },
              "contentName": "source.embedded.kotlin",
              "patterns": [
                {
                  "include": "#braces"
                },
                {
                  "include": "$self"
                }
              ]
            },
            {
              "match": "(\\$)([A-Za-z_]\\w*)",
              "captures": {
                "1": {
                  "name": "punctuation.definition.template-expression.begin.kotlin"
                },
                "2": {
                  "name": "variable.other.interpolated.kotlin"
                }
              }
            }
          ]
        },
        {
          "name": "string.quoted.double.kotlin",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.kotlin"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.kotlin"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.kotlin",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            },
            {
              "name": "meta.embedded.interpolation.kotlin",
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.kotlin"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.kotlin"
                }
              },
              "contentName": "source.embedded.kotlin",
              "patterns": [
                {
                  "include": "#braces"
                },
                {
                  "include": "$self"
                }
              ]
            },
            {
              "match": "(\\$)([A-Za-z_]\\w*)",
              "captures": {
                "1": {
                  "name": "punctuation.definition.template-expression.begin.kotlin"
                },
                "2": {
                  "name": "variable.other.interpolated.kotlin"
                }
              }
            }
          ]
        },
        {
          "name": "string.quoted.single.kotlin",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.kotlin"
            }
          },
          "end": "'|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.kotlin"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.kotlin",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            }
          ]
        }
      ]
    },
    "annotation": {
      "name": "meta.decorator.kotlin",
      "match": "@(?:[A-Za-z_][\\w.]*:)?[A-Za-z_][\\w.]*",
      "captures": {
        "0": {
          "name": "entity.name.function.decorator.kotlin"
        }
      }
    },
    "function-definition": {
      "match": "\\b(fun)\\b\\s+(?:<[^>]*>\\s*)?(?:[A-Za-z_][\\w.]*\\.)?([A-Za-z_][\\w!?']*)",
      "captures": {
        "1": {
          "name": "storage.type.function.kotlin"
        },
        "2": {
          "name": "entity.name.function.kotlin"
        }
      }
    },
    "type-definition": {
      "match": "\\b(class|interface|object|typealias)\\b\\s+([A-Za-z_][\\w.]*)",
      "captures": {
        "1": {
          "name": "storage.type.kotlin"
        },
        "2": {
          "name": "entity.name.type.kotlin"
        }
      }
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.kotlin",
          "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.binary.kotlin",
          "match": "\\b0[bB][01][01_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.octal.kotlin",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.kotlin",
          "match": "(?:\\b\\d[\\d_]*\\.\\d[\\d_]*|\\B\\.\\d[\\d_]*)(?:[eE][+-]?\\d+)?(?:[fFdDhH]|f16|f32|f64)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d+(?:[fFdD])?\\b"
        },
        {
          "name": "constant.numeric.integer.kotlin",
          "match": "\\b\\d[\\d_]*(?:[uUlLnfFdDiI]\\w*)?\\b"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.kotlin",
          "match": "\\b(?:if|else|when|for|while|do|try|catch|finally|throw|return|break|continue)\\b"
        },
        {
          "name": "storage.type.kotlin",
          "match": "\\b(?:fun|val|var|class|interface|object|typealias|constructor|init|companion|package|import|get|set|by|where)\\b"
        },
        {
          "name": "storage.modifier.kotlin",
          "match": "\\b(?:public|private|protected|internal|open|final|abstract|override|sealed|data|enum|inner|annotation|inline|value|noinline|crossinline|reified|tailrec|operator|infix|suspend|external|const|lateinit|vararg|expect|actual|out|in)\\b"
        },
        {
          "name": "keyword.operator.word.kotlin",
          "match": "(?<![\\w.])(?:is|as|in|!in|!is)(?![\\w?])"
        },
        {
          "name": "constant.language.kotlin",
          "match": "\\b(?:true|false|null)\\b"
        },
        {
          "name": "variable.language.kotlin",
          "match": "\\b(?:this|super|it|field)\\b"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "name": "support.type.kotlin",
          "match": "\\b(?:Any|Unit|Nothing|Int|Long|Short|Byte|Float|Double|Boolean|Char|String|Array|List|MutableList|Map|MutableMap|Set|MutableSet|UInt|ULong|UShort|UByte)\\b"
        }
      ]
    },
    "builtin": {
      "match": "\\b(println|print|listOf|mutableListOf|mapOf|mutableMapOf|setOf|mutableSetOf|arrayOf|emptyList|emptyMap|require|requireNotNull|check|checkNotNull|error|lazy|repeat|run|let|apply|also|with|takeIf|TODO)\\b(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "support.function.builtin.kotlin"
        }
      }
    },
    "constant-caps": {
      "name": "constant.other.caps.kotlin",
      "match": "\\b[A-Z][A-Z0-9_]*[A-Z0-9]\\b(?![a-z(])"
    },
    "type-name": {
      "name": "entity.name.type.kotlin",
      "match": "\\b[A-Z][A-Za-z0-9_]*[a-z][A-Za-z0-9_]*\\b"
    },
    "call": {
      "match": "\\b([A-Za-z_][\\w!?]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.kotlin"
        }
      }
    },
    "member": {
      "match": "(\\.)\\s*([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.kotlin"
        },
        "2": {
          "name": "variable.other.property.kotlin"
        }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.kotlin",
          "match": "=>|->|<-|\\|>"
        },
        {
          "name": "keyword.operator.comparison.kotlin",
          "match": "===|!==|==|!=|<=|>="
        },
        {
          "name": "keyword.operator.assignment.kotlin",
          "match": "(?:\\+|-|\\*|/|%|&|\\||\\^|<<|>>|\\?\\?)?=(?![=>])|:="
        },
        {
          "name": "keyword.operator.logical.kotlin",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.range.kotlin",
          "match": "\\.\\.[.<=]?"
        },
        {
          "name": "keyword.operator.arithmetic.kotlin",
          "match": "\\*\\*|\\+\\+|--|[-+*/%]"
        },
        {
          "name": "keyword.operator.bitwise.kotlin",
          "match": "<<|>>|[&|^~]"
        },
        {
          "name": "keyword.operator.comparison.kotlin",
          "match": "[<>]"
        },
        {
          "name": "keyword.operator.kotlin",
          "match": "\\?|::|:|@"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.kotlin"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.kotlin"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.kotlin",
          "match": ";"
        },
        {
          "name": "punctuation.separator.kotlin",
          "match": ","
        },
        {
          "name": "punctuation.section.brackets.kotlin",
          "match": "[()\\[\\]{}]"
        }
      ]
    }
  }
}
