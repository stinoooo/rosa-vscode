{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Dart",
  "scopeName": "source.dart",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#annotation"
    },
    {
      "include": "#type-definition"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#type"
    },
    {
      "include": "#builtin"
    },
    {
      "include": "#constant-caps"
    },
    {
      "include": "#type-name"
    },
    {
      "include": "#call"
    },
    {
      "include": "#member"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment-block": {
      "name": "comment.block.dart",
      "begin": "/\\*",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.dart"
        }
      },
      "end": "\\*/",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.dart"
        }
      },
      "patterns": [
        {
          "include": "#todo"
        }
      ]
    },
    "todo": {
      "name": "keyword.other.todo.dart",
      "match": "\\b(?:TODO|FIXME|HACK|NOTE|XXX|BUG)\\b"
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.block.documentation.dart",
          "begin": "/\\*\\*(?!/)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.dart"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.dart"
            }
          },
          "patterns": [
            {
              "name": "keyword.other.documentation.dart",
              "match": "@[A-Za-z]+"
            },
            {
              "include": "#todo"
            }
          ]
        },
        {
          "include": "#comment-block"
        },
        {
          "name": "comment.line.dart",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.dart"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#todo"
            }
          ]
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.raw.dart",
          "begin": "r'''",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dart"
            }
          },
          "end": "'''",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dart"
            }
          },
          "patterns": []
        },
        {
          "name": "string.quoted.raw.dart",
          "begin": "r\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dart"
            }
          },
          "end": "\"\"\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dart"
            }
          },
          "patterns": []
        },
        {
          "name": "string.quoted.raw.dart",
          "begin": "r'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dart"
            }
          },
          "end": "'|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dart"
            }
          },
          "patterns": []
        },
        {
          "name": "string.quoted.raw.dart",
          "begin": "r\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dart"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dart"
            }
          },
          "patterns": []
        },
        {
          "name": "string.quoted.triple.dart",
          "begin": "'''",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dart"
            }
          },
          "end": "'''",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dart"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.dart",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            },
            {
              "name": "meta.embedded.interpolation.dart",
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.dart"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.dart"
                }
              },
              "contentName": "source.embedded.dart",
              "patterns": [
                {
                  "include": "#braces"
                },
                {
                  "include": "$self"
                }
              ]
            },
            {
              "match": "(\\$)([A-Za-z_]\\w*)",
              "captures": {
                "1": {
                  "name": "punctuation.definition.template-expression.begin.dart"
                },
                "2": {
                  "name": "variable.other.interpolated.dart"
                }
              }
            }
          ]
        },
        {
          "name": "string.quoted.triple.dart",
          "begin": "\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dart"
            }
          },
          "end": "\"\"\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dart"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.dart",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            },
            {
              "name": "meta.embedded.interpolation.dart",
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.dart"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.dart"
                }
              },
              "contentName": "source.embedded.dart",
              "patterns": [
                {
                  "include": "#braces"
                },
                {
                  "include": "$self"
                }
              ]
            },
            {
              "match": "(\\$)([A-Za-z_]\\w*)",
              "captures": {
                "1": {
                  "name": "punctuation.definition.template-expression.begin.dart"
                },
                "2": {
                  "name": "variable.other.interpolated.dart"
                }
              }
            }
          ]
        },
        {
          "name": "string.quoted.single.dart",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dart"
            }
          },
          "end": "'|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dart"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.dart",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            },
            {
              "name": "meta.embedded.interpolation.dart",
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.dart"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.dart"
                }
              },
              "contentName": "source.embedded.dart",
              "patterns": [
                {
                  "include": "#braces"
                },
                {
                  "include": "$self"
                }
              ]
            },
            {
              "match": "(\\$)([A-Za-z_]\\w*)",
              "captures": {
                "1": {
                  "name": "punctuation.definition.template-expression.begin.dart"
                },
                "2": {
                  "name": "variable.other.interpolated.dart"
                }
              }
            }
          ]
        },
        {
          "name": "string.quoted.double.dart",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dart"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dart"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.dart",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            },
            {
              "name": "meta.embedded.interpolation.dart",
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.dart"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.dart"
                }
              },
              "contentName": "source.embedded.dart",
              "patterns": [
                {
                  "include": "#braces"
                },
                {
                  "include": "$self"
                }
              ]
            },
            {
              "match": "(\\$)([A-Za-z_]\\w*)",
              "captures": {
                "1": {
                  "name": "punctuation.definition.template-expression.begin.dart"
                },
                "2": {
                  "name": "variable.other.interpolated.dart"
                }
              }
            }
          ]
        }
      ]
    },
    "annotation": {
      "name": "meta.decorator.dart",
      "match": "@[A-Za-z_][\\w.]*",
      "captures": {
        "0": {
          "name": "entity.name.function.decorator.dart"
        }
      }
    },
    "type-definition": {
      "match": "\\b(class|enum|mixin|extension|typedef)\\b\\s+([A-Za-z_][\\w.]*)",
      "captures": {
        "1": {
          "name": "storage.type.dart"
        },
        "2": {
          "name": "entity.name.type.dart"
        }
      }
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.dart",
          "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.binary.dart",
          "match": "\\b0[bB][01][01_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.octal.dart",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.dart",
          "match": "(?:\\b\\d[\\d_]*\\.\\d[\\d_]*|\\B\\.\\d[\\d_]*)(?:[eE][+-]?\\d+)?(?:[fFdDhH]|f16|f32|f64)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d+(?:[fFdD])?\\b"
        },
        {
          "name": "constant.numeric.integer.dart",
          "match": "\\b\\d[\\d_]*(?:[uUlLnfFdDiI]\\w*)?\\b"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.dart",
          "match": "\\b(?:if|else|for|while|do|switch|case|default|break|continue|return|try|catch|finally|throw|rethrow|on|await|yield|assert|when)\\b"
        },
        {
          "name": "storage.type.dart",
          "match": "\\b(?:class|enum|mixin|extension|typedef|import|export|library|part|of|show|hide|as|deferred|var|final|const|late|void|dynamic|type|with|implements|extends|get|set|operator|factory|new)\\b"
        },
        {
          "name": "storage.modifier.dart",
          "match": "\\b(?:static|abstract|external|covariant|required|async|sync|base|interface|sealed|macro|augment)\\b"
        },
        {
          "name": "keyword.operator.word.dart",
          "match": "(?<![\\w.])(?:is|as|in)(?![\\w?])"
        },
        {
          "name": "constant.language.dart",
          "match": "\\b(?:true|false|null)\\b"
        },
        {
          "name": "variable.language.dart",
          "match": "\\b(?:this|super)\\b"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "name": "support.type.dart",
          "match": "\\b(?:int|double|num|bool|String|List|Map|Set|Iterable|Future|Stream|Object|Never|Function|Record|Symbol|Type|Duration|DateTime|Uri)\\b"
        }
      ]
    },
    "builtin": {
      "match": "\\b(print|identical|identityHashCode)\\b(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "support.function.builtin.dart"
        }
      }
    },
    "constant-caps": {
      "name": "constant.other.caps.dart",
      "match": "\\b[A-Z][A-Z0-9_]*[A-Z0-9]\\b(?![a-z(])"
    },
    "type-name": {
      "name": "entity.name.type.dart",
      "match": "\\b[A-Z][A-Za-z0-9_]*[a-z][A-Za-z0-9_]*\\b"
    },
    "call": {
      "match": "\\b([A-Za-z_][\\w!?]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.dart"
        }
      }
    },
    "member": {
      "match": "(\\.)\\s*([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.dart"
        },
        "2": {
          "name": "variable.other.property.dart"
        }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.dart",
          "match": "=>|->|<-|\\|>"
        },
        {
          "name": "keyword.operator.comparison.dart",
          "match": "===|!==|==|!=|<=|>="
        },
        {
          "name": "keyword.operator.assignment.dart",
          "match": "(?:\\+|-|\\*|/|%|&|\\||\\^|<<|>>|\\?\\?)?=(?![=>])|:="
        },
        {
          "name": "keyword.operator.logical.dart",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.range.dart",
          "match": "\\.\\.[.<=]?"
        },
        {
          "name": "keyword.operator.arithmetic.dart",
          "match": "\\*\\*|\\+\\+|--|[-+*/%]"
        },
        {
          "name": "keyword.operator.bitwise.dart",
          "match": "<<|>>|[&|^~]"
        },
        {
          "name": "keyword.operator.comparison.dart",
          "match": "[<>]"
        },
        {
          "name": "keyword.operator.dart",
          "match": "\\?|::|:|@"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.dart"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.dart"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.dart",
          "match": ";"
        },
        {
          "name": "punctuation.separator.dart",
          "match": ","
        },
        {
          "name": "punctuation.section.brackets.dart",
          "match": "[()\\[\\]{}]"
        }
      ]
    }
  }
}
