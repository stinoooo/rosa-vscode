{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zig",
  "scopeName": "source.zig",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#extra-0"
    },
    {
      "include": "#extra-1"
    },
    {
      "include": "#string"
    },
    {
      "include": "#function-definition"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#type"
    },
    {
      "include": "#constant-caps"
    },
    {
      "include": "#type-name"
    },
    {
      "include": "#call"
    },
    {
      "include": "#member"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "todo": {
      "name": "keyword.other.todo.zig",
      "match": "\\b(?:TODO|FIXME|HACK|NOTE|XXX|BUG)\\b"
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.line.zig",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.zig"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#todo"
            }
          ]
        }
      ]
    },
    "extra-0": {
      "name": "string.quoted.multiline.zig",
      "match": "\\\\\\\\.*$"
    },
    "extra-1": {
      "name": "support.function.builtin.zig",
      "match": "@[A-Za-z_]\\w*"
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.zig",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.zig"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.zig"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.zig",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            }
          ]
        },
        {
          "name": "string.quoted.single.zig",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.zig"
            }
          },
          "end": "'|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.zig"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.zig",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            }
          ]
        }
      ]
    },
    "function-definition": {
      "match": "\\b(fn)\\b\\s+(?:<[^>]*>\\s*)?(?:[A-Za-z_][\\w.]*\\.)?([A-Za-z_][\\w!?']*)",
      "captures": {
        "1": {
          "name": "storage.type.function.zig"
        },
        "2": {
          "name": "entity.name.function.zig"
        }
      }
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.zig",
          "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.binary.zig",
          "match": "\\b0[bB][01][01_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.octal.zig",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.zig",
          "match": "(?:\\b\\d[\\d_]*\\.\\d[\\d_]*|\\B\\.\\d[\\d_]*)(?:[eE][+-]?\\d+)?(?:[fFdDhH]|f16|f32|f64)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d+(?:[fFdD])?\\b"
        },
        {
          "name": "constant.numeric.integer.zig",
          "match": "\\b\\d[\\d_]*(?:[uUlLnfFdDiI]\\w*)?\\b"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.zig",
          "match": "\\b(?:if|else|switch|while|for|break|continue|return|try|catch|orelse|defer|errdefer|unreachable|suspend|resume|nosuspend|await|async)\\b"
        },
        {
          "name": "storage.type.zig",
          "match": "\\b(?:fn|const|var|struct|enum|union|error|opaque|test|comptime|usingnamespace)\\b"
        },
        {
          "name": "storage.modifier.zig",
          "match": "\\b(?:pub|export|extern|inline|noinline|packed|align|volatile|allowzero|threadlocal|linksection|callconv|noalias)\\b"
        },
        {
          "name": "keyword.operator.word.zig",
          "match": "(?<![\\w.])(?:and|or)(?![\\w?])"
        },
        {
          "name": "constant.language.zig",
          "match": "\\b(?:true|false|null|undefined)\\b"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "name": "support.type.zig",
          "match": "\\b(?:i8|u8|i16|u16|i32|u32|i64|u64|i128|u128|isize|usize|c_char|c_short|c_ushort|c_int|c_uint|c_long|c_ulong|c_longlong|c_ulonglong|c_longdouble|f16|f32|f64|f80|f128|bool|anyopaque|void|noreturn|type|anyerror|comptime_int|comptime_float|anytype|anyframe)\\b"
        },
        {
          "name": "support.type.zig",
          "match": "\\b[iu]\\d+\\b"
        }
      ]
    },
    "constant-caps": {
      "name": "constant.other.caps.zig",
      "match": "\\b[A-Z][A-Z0-9_]*[A-Z0-9]\\b(?![a-z(])"
    },
    "type-name": {
      "name": "entity.name.type.zig",
      "match": "\\b[A-Z][A-Za-z0-9_]*[a-z][A-Za-z0-9_]*\\b"
    },
    "call": {
      "match": "\\b([A-Za-z_][\\w!?]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.zig"
        }
      }
    },
    "member": {
      "match": "(\\.)\\s*([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.zig"
        },
        "2": {
          "name": "variable.other.property.zig"
        }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.zig",
          "match": "=>|->|<-|\\|>"
        },
        {
          "name": "keyword.operator.comparison.zig",
          "match": "===|!==|==|!=|<=|>="
        },
        {
          "name": "keyword.operator.assignment.zig",
          "match": "(?:\\+|-|\\*|/|%|&|\\||\\^|<<|>>|\\?\\?)?=(?![=>])|:="
        },
        {
          "name": "keyword.operator.logical.zig",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.range.zig",
          "match": "\\.\\.[.<=]?"
        },
        {
          "name": "keyword.operator.arithmetic.zig",
          "match": "\\*\\*|\\+\\+|--|[-+*/%]"
        },
        {
          "name": "keyword.operator.bitwise.zig",
          "match": "<<|>>|[&|^~]"
        },
        {
          "name": "keyword.operator.comparison.zig",
          "match": "[<>]"
        },
        {
          "name": "keyword.operator.zig",
          "match": "\\?|::|:|@"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.zig"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.zig"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.zig",
          "match": ";"
        },
        {
          "name": "punctuation.separator.zig",
          "match": ","
        },
        {
          "name": "punctuation.section.brackets.zig",
          "match": "[()\\[\\]{}]"
        }
      ]
    }
  }
}
