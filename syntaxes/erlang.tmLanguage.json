{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Erlang",
  "scopeName": "source.erlang",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#extra-0"
    },
    {
      "include": "#extra-1"
    },
    {
      "include": "#extra-2"
    },
    {
      "include": "#extra-3"
    },
    {
      "include": "#extra-4"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#builtin"
    },
    {
      "include": "#call"
    },
    {
      "include": "#member"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "todo": {
      "name": "keyword.other.todo.erlang",
      "match": "\\b(?:TODO|FIXME|HACK|NOTE|XXX|BUG)\\b"
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.line.erlang",
          "begin": "%",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.erlang"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#todo"
            }
          ]
        }
      ]
    },
    "extra-0": {
      "name": "meta.decorator.erlang entity.name.function.decorator.erlang",
      "match": "^-[a-z_]\\w*"
    },
    "extra-1": {
      "name": "variable.other.erlang",
      "match": "\\b[A-Z_][\\w]*\\b"
    },
    "extra-2": {
      "name": "constant.other.macro.erlang",
      "match": "\\?\\??[A-Za-z_]\\w*"
    },
    "extra-3": {
      "name": "constant.character.erlang",
      "match": "\\$\\\\?."
    },
    "extra-4": {
      "match": "^([a-z]\\w*)(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.erlang"
        }
      }
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.erlang",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.erlang"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.erlang"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.erlang",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            }
          ]
        },
        {
          "name": "constant.other.symbol.erlang",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.erlang"
            }
          },
          "end": "'|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.erlang"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.erlang",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            }
          ]
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.erlang",
          "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.binary.erlang",
          "match": "\\b0[bB][01][01_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.octal.erlang",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.erlang",
          "match": "(?:\\b\\d[\\d_]*\\.\\d[\\d_]*|\\B\\.\\d[\\d_]*)(?:[eE][+-]?\\d+)?(?:[fFdDhH]|f16|f32|f64)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d+(?:[fFdD])?\\b"
        },
        {
          "name": "constant.numeric.integer.erlang",
          "match": "\\b\\d[\\d_]*(?:[uUlLnfFdDiI]\\w*)?\\b"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.erlang",
          "match": "\\b(?:if|case|of|end|receive|after|when|try|catch|throw|begin|fun|maybe|else)\\b"
        },
        {
          "name": "keyword.operator.word.erlang",
          "match": "(?<![\\w.])(?:and|andalso|or|orelse|not|xor|band|bor|bxor|bnot|bsl|bsr|div|rem)(?![\\w?])"
        },
        {
          "name": "constant.language.erlang",
          "match": "\\b(?:true|false|undefined|ok|error)\\b"
        }
      ]
    },
    "builtin": {
      "match": "\\b(spawn|spawn_link|self|exit|error|throw|apply|is_atom|is_list|is_integer|is_binary|length|element|hd|tl)\\b(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "support.function.builtin.erlang"
        }
      }
    },
    "call": {
      "match": "\\b([A-Za-z_][\\w!?]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.erlang"
        }
      }
    },
    "member": {
      "match": "(\\.)\\s*([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.erlang"
        },
        "2": {
          "name": "variable.other.property.erlang"
        }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.erlang",
          "match": "=>|->|<-|\\|>"
        },
        {
          "name": "keyword.operator.comparison.erlang",
          "match": "===|!==|==|!=|<=|>="
        },
        {
          "name": "keyword.operator.assignment.erlang",
          "match": "(?:\\+|-|\\*|/|%|&|\\||\\^|<<|>>|\\?\\?)?=(?![=>])|:="
        },
        {
          "name": "keyword.operator.logical.erlang",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.range.erlang",
          "match": "\\.\\.[.<=]?"
        },
        {
          "name": "keyword.operator.arithmetic.erlang",
          "match": "\\*\\*|\\+\\+|--|[-+*/%]"
        },
        {
          "name": "keyword.operator.bitwise.erlang",
          "match": "<<|>>|[&|^~]"
        },
        {
          "name": "keyword.operator.comparison.erlang",
          "match": "[<>]"
        },
        {
          "name": "keyword.operator.erlang",
          "match": "\\?|::|:|@"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.erlang"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.erlang"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.erlang",
          "match": ";"
        },
        {
          "name": "punctuation.separator.erlang",
          "match": ","
        },
        {
          "name": "punctuation.section.brackets.erlang",
          "match": "[()\\[\\]{}]"
        }
      ]
    }
  }
}
