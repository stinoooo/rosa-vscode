{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Prisma",
  "scopeName": "source.prisma",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#extra-0"
    },
    {
      "include": "#extra-1"
    },
    {
      "include": "#extra-2"
    },
    {
      "include": "#string"
    },
    {
      "include": "#type-definition"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#type"
    },
    {
      "include": "#builtin"
    },
    {
      "include": "#constant-caps"
    },
    {
      "include": "#type-name"
    },
    {
      "include": "#call"
    },
    {
      "include": "#member"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "todo": {
      "name": "keyword.other.todo.prisma",
      "match": "\\b(?:TODO|FIXME|HACK|NOTE|XXX|BUG)\\b"
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.line.prisma",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.prisma"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#todo"
            }
          ]
        }
      ]
    },
    "extra-0": {
      "name": "meta.decorator.prisma entity.name.function.decorator.prisma",
      "match": "@@?[A-Za-z_][\\w.]*"
    },
    "extra-1": {
      "match": "^\\s*([A-Za-z_]\\w*)\\s+([A-Za-z_]\\w*)(\\[\\])?(\\?)?",
      "captures": {
        "1": {
          "name": "variable.other.property.prisma"
        },
        "2": {
          "name": "entity.name.type.prisma"
        },
        "3": {
          "name": "keyword.operator.prisma"
        },
        "4": {
          "name": "keyword.operator.optional.prisma"
        }
      }
    },
    "extra-2": {
      "match": "^\\s*([A-Za-z_]\\w*)\\s*(=)",
      "captures": {
        "1": {
          "name": "variable.other.property.prisma"
        },
        "2": {
          "name": "keyword.operator.assignment.prisma"
        }
      }
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.prisma",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.prisma"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.prisma"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.prisma",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            }
          ]
        }
      ]
    },
    "type-definition": {
      "match": "\\b(model|enum|datasource|generator|type|view)\\b\\s+([A-Za-z_][\\w.]*)",
      "captures": {
        "1": {
          "name": "storage.type.prisma"
        },
        "2": {
          "name": "entity.name.type.prisma"
        }
      }
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.prisma",
          "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.binary.prisma",
          "match": "\\b0[bB][01][01_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.octal.prisma",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.prisma",
          "match": "(?:\\b\\d[\\d_]*\\.\\d[\\d_]*|\\B\\.\\d[\\d_]*)(?:[eE][+-]?\\d+)?(?:[fFdDhH]|f16|f32|f64)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d+(?:[fFdD])?\\b"
        },
        {
          "name": "constant.numeric.integer.prisma",
          "match": "\\b\\d[\\d_]*(?:[uUlLnfFdDiI]\\w*)?\\b"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "storage.type.prisma",
          "match": "\\b(?:model|enum|datasource|generator|type|view)\\b"
        },
        {
          "name": "constant.language.prisma",
          "match": "\\b(?:true|false|null)\\b"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "name": "support.type.prisma",
          "match": "\\b(?:String|Int|BigInt|Float|Decimal|Boolean|DateTime|Json|Bytes|Unsupported)\\b"
        }
      ]
    },
    "builtin": {
      "match": "\\b(env|autoincrement|now|uuid|cuid|dbgenerated|sequence|ulid|nanoid)\\b(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "support.function.builtin.prisma"
        }
      }
    },
    "constant-caps": {
      "name": "constant.other.caps.prisma",
      "match": "\\b[A-Z][A-Z0-9_]*[A-Z0-9]\\b(?![a-z(])"
    },
    "type-name": {
      "name": "entity.name.type.prisma",
      "match": "\\b[A-Z][A-Za-z0-9_]*[a-z][A-Za-z0-9_]*\\b"
    },
    "call": {
      "match": "\\b([A-Za-z_][\\w!?]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.prisma"
        }
      }
    },
    "member": {
      "match": "(\\.)\\s*([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.prisma"
        },
        "2": {
          "name": "variable.other.property.prisma"
        }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.prisma",
          "match": "=>|->|<-|\\|>"
        },
        {
          "name": "keyword.operator.comparison.prisma",
          "match": "===|!==|==|!=|<=|>="
        },
        {
          "name": "keyword.operator.assignment.prisma",
          "match": "(?:\\+|-|\\*|/|%|&|\\||\\^|<<|>>|\\?\\?)?=(?![=>])|:="
        },
        {
          "name": "keyword.operator.logical.prisma",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.range.prisma",
          "match": "\\.\\.[.<=]?"
        },
        {
          "name": "keyword.operator.arithmetic.prisma",
          "match": "\\*\\*|\\+\\+|--|[-+*/%]"
        },
        {
          "name": "keyword.operator.bitwise.prisma",
          "match": "<<|>>|[&|^~]"
        },
        {
          "name": "keyword.operator.comparison.prisma",
          "match": "[<>]"
        },
        {
          "name": "keyword.operator.prisma",
          "match": "\\?|::|:|@"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.prisma"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.prisma"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.prisma",
          "match": ";"
        },
        {
          "name": "punctuation.separator.prisma",
          "match": ","
        },
        {
          "name": "punctuation.section.brackets.prisma",
          "match": "[()\\[\\]{}]"
        }
      ]
    }
  }
}
