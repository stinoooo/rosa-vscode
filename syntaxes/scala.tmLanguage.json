{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Scala",
  "scopeName": "source.scala",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#annotation"
    },
    {
      "include": "#function-definition"
    },
    {
      "include": "#type-definition"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#type"
    },
    {
      "include": "#builtin"
    },
    {
      "include": "#constant-caps"
    },
    {
      "include": "#type-name"
    },
    {
      "include": "#call"
    },
    {
      "include": "#member"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment-block": {
      "name": "comment.block.scala",
      "begin": "/\\*",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.scala"
        }
      },
      "end": "\\*/",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.scala"
        }
      },
      "patterns": [
        {
          "include": "#todo"
        },
        {
          "include": "#comment-block"
        }
      ]
    },
    "todo": {
      "name": "keyword.other.todo.scala",
      "match": "\\b(?:TODO|FIXME|HACK|NOTE|XXX|BUG)\\b"
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.block.documentation.scala",
          "begin": "/\\*\\*(?!/)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.scala"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.scala"
            }
          },
          "patterns": [
            {
              "name": "keyword.other.documentation.scala",
              "match": "@[A-Za-z]+"
            },
            {
              "include": "#todo"
            }
          ]
        },
        {
          "include": "#comment-block"
        },
        {
          "name": "comment.line.scala",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.scala"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#todo"
            }
          ]
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.triple.scala",
          "begin": "(?:[a-z]\\w*)?\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.scala"
            }
          },
          "end": "\"\"\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.scala"
            }
          },
          "patterns": [
            {
              "name": "meta.embedded.interpolation.scala",
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.scala"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.scala"
                }
              },
              "contentName": "source.embedded.scala",
              "patterns": [
                {
                  "include": "#braces"
                },
                {
                  "include": "$self"
                }
              ]
            },
            {
              "match": "(\\$)([A-Za-z_]\\w*)",
              "captures": {
                "1": {
                  "name": "punctuation.definition.template-expression.begin.scala"
                },
                "2": {
                  "name": "variable.other.interpolated.scala"
                }
              }
            }
          ]
        },
        {
          "name": "string.quoted.double.scala",
          "begin": "(?:[a-z]\\w*)?\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.scala"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.scala"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.scala",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            },
            {
              "name": "meta.embedded.interpolation.scala",
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.scala"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.scala"
                }
              },
              "contentName": "source.embedded.scala",
              "patterns": [
                {
                  "include": "#braces"
                },
                {
                  "include": "$self"
                }
              ]
            },
            {
              "match": "(\\$)([A-Za-z_]\\w*)",
              "captures": {
                "1": {
                  "name": "punctuation.definition.template-expression.begin.scala"
                },
                "2": {
                  "name": "variable.other.interpolated.scala"
                }
              }
            }
          ]
        },
        {
          "name": "string.quoted.single.scala",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.scala"
            }
          },
          "end": "'|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.scala"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.scala",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            }
          ]
        }
      ]
    },
    "annotation": {
      "name": "meta.decorator.scala",
      "match": "@[A-Za-z_][\\w.]*",
      "captures": {
        "0": {
          "name": "entity.name.function.decorator.scala"
        }
      }
    },
    "function-definition": {
      "match": "\\b(def)\\b\\s+(?:<[^>]*>\\s*)?(?:[A-Za-z_][\\w.]*\\.)?([A-Za-z_][\\w!?']*)",
      "captures": {
        "1": {
          "name": "storage.type.function.scala"
        },
        "2": {
          "name": "entity.name.function.scala"
        }
      }
    },
    "type-definition": {
      "match": "\\b(class|object|trait|enum|type)\\b\\s+([A-Za-z_][\\w.]*)",
      "captures": {
        "1": {
          "name": "storage.type.scala"
        },
        "2": {
          "name": "entity.name.type.scala"
        }
      }
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.scala",
          "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.binary.scala",
          "match": "\\b0[bB][01][01_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.octal.scala",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.scala",
          "match": "(?:\\b\\d[\\d_]*\\.\\d[\\d_]*|\\B\\.\\d[\\d_]*)(?:[eE][+-]?\\d+)?(?:[fFdDhH]|f16|f32|f64)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d+(?:[fFdD])?\\b"
        },
        {
          "name": "constant.numeric.integer.scala",
          "match": "\\b\\d[\\d_]*(?:[uUlLnfFdDiI]\\w*)?\\b"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.scala",
          "match": "\\b(?:if|then|else|match|case|for|while|do|yield|try|catch|finally|throw|return)\\b"
        },
        {
          "name": "storage.type.scala",
          "match": "\\b(?:def|val|var|lazy|class|object|trait|enum|type|given|using|extension|package|import|export|extends|with|derives|new|end)\\b"
        },
        {
          "name": "storage.modifier.scala",
          "match": "\\b(?:private|protected|override|abstract|final|sealed|implicit|inline|opaque|open|transparent|infix|case)\\b"
        },
        {
          "name": "constant.language.scala",
          "match": "\\b(?:true|false|null)\\b"
        },
        {
          "name": "variable.language.scala",
          "match": "\\b(?:this|super)\\b"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "name": "support.type.scala",
          "match": "\\b(?:Int|Long|Short|Byte|Float|Double|Boolean|Char|String|Unit|Any|AnyRef|AnyVal|Nothing|Null|Option|Some|None|List|Seq|Vector|Map|Set|Either|Left|Right|Future|Array)\\b"
        }
      ]
    },
    "builtin": {
      "match": "\\b(println|print|require|assert)\\b(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "support.function.builtin.scala"
        }
      }
    },
    "constant-caps": {
      "name": "constant.other.caps.scala",
      "match": "\\b[A-Z][A-Z0-9_]*[A-Z0-9]\\b(?![a-z(])"
    },
    "type-name": {
      "name": "entity.name.type.scala",
      "match": "\\b[A-Z][A-Za-z0-9_]*[a-z][A-Za-z0-9_]*\\b"
    },
    "call": {
      "match": "\\b([A-Za-z_][\\w!?]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.scala"
        }
      }
    },
    "member": {
      "match": "(\\.)\\s*([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.scala"
        },
        "2": {
          "name": "variable.other.property.scala"
        }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.scala",
          "match": "=>|->|<-|\\|>"
        },
        {
          "name": "keyword.operator.comparison.scala",
          "match": "===|!==|==|!=|<=|>="
        },
        {
          "name": "keyword.operator.assignment.scala",
          "match": "(?:\\+|-|\\*|/|%|&|\\||\\^|<<|>>|\\?\\?)?=(?![=>])|:="
        },
        {
          "name": "keyword.operator.logical.scala",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.range.scala",
          "match": "\\.\\.[.<=]?"
        },
        {
          "name": "keyword.operator.arithmetic.scala",
          "match": "\\*\\*|\\+\\+|--|[-+*/%]"
        },
        {
          "name": "keyword.operator.bitwise.scala",
          "match": "<<|>>|[&|^~]"
        },
        {
          "name": "keyword.operator.comparison.scala",
          "match": "[<>]"
        },
        {
          "name": "keyword.operator.scala",
          "match": "\\?|::|:|@"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.scala"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.scala"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.scala",
          "match": ";"
        },
        {
          "name": "punctuation.separator.scala",
          "match": ","
        },
        {
          "name": "punctuation.section.brackets.scala",
          "match": "[()\\[\\]{}]"
        }
      ]
    }
  }
}
