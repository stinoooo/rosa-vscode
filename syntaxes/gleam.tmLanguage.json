{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Gleam",
  "scopeName": "source.gleam",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#annotation"
    },
    {
      "include": "#function-definition"
    },
    {
      "include": "#type-definition"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#type"
    },
    {
      "include": "#constant-caps"
    },
    {
      "include": "#type-name"
    },
    {
      "include": "#call"
    },
    {
      "include": "#member"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "todo": {
      "name": "keyword.other.todo.gleam",
      "match": "\\b(?:TODO|FIXME|HACK|NOTE|XXX|BUG)\\b"
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.line.gleam",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.gleam"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#todo"
            }
          ]
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.gleam",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.gleam"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.gleam"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.gleam",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            }
          ]
        }
      ]
    },
    "annotation": {
      "name": "meta.decorator.gleam",
      "match": "@[a-z_]\\w*",
      "captures": {
        "0": {
          "name": "entity.name.function.decorator.gleam"
        }
      }
    },
    "function-definition": {
      "match": "\\b(fn)\\b\\s+(?:<[^>]*>\\s*)?(?:[A-Za-z_][\\w.]*\\.)?([A-Za-z_][\\w!?']*)",
      "captures": {
        "1": {
          "name": "storage.type.function.gleam"
        },
        "2": {
          "name": "entity.name.function.gleam"
        }
      }
    },
    "type-definition": {
      "match": "\\b(type)\\b\\s+([A-Za-z_][\\w.]*)",
      "captures": {
        "1": {
          "name": "storage.type.gleam"
        },
        "2": {
          "name": "entity.name.type.gleam"
        }
      }
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.gleam",
          "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.binary.gleam",
          "match": "\\b0[bB][01][01_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.octal.gleam",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.gleam",
          "match": "(?:\\b\\d[\\d_]*\\.\\d[\\d_]*|\\B\\.\\d[\\d_]*)(?:[eE][+-]?\\d+)?(?:[fFdDhH]|f16|f32|f64)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d+(?:[fFdD])?\\b"
        },
        {
          "name": "constant.numeric.integer.gleam",
          "match": "\\b\\d[\\d_]*(?:[uUlLnfFdDiI]\\w*)?\\b"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.gleam",
          "match": "\\b(?:case|if|use|try|assert|panic|todo|echo|let)\\b"
        },
        {
          "name": "storage.type.gleam",
          "match": "\\b(?:fn|type|const|import|as|opaque|external)\\b"
        },
        {
          "name": "storage.modifier.gleam",
          "match": "\\b(?:pub)\\b"
        },
        {
          "name": "constant.language.gleam",
          "match": "\\b(?:True|False|Nil)\\b"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "name": "support.type.gleam",
          "match": "\\b(?:Int|Float|String|Bool|List|Result|Option|BitArray|Dict)\\b"
        }
      ]
    },
    "constant-caps": {
      "name": "constant.other.caps.gleam",
      "match": "\\b[A-Z][A-Z0-9_]*[A-Z0-9]\\b(?![a-z(])"
    },
    "type-name": {
      "name": "entity.name.type.gleam",
      "match": "\\b[A-Z][A-Za-z0-9_]*[a-z][A-Za-z0-9_]*\\b"
    },
    "call": {
      "match": "\\b([A-Za-z_][\\w!?]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.gleam"
        }
      }
    },
    "member": {
      "match": "(\\.)\\s*([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.gleam"
        },
        "2": {
          "name": "variable.other.property.gleam"
        }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.gleam",
          "match": "=>|->|<-|\\|>"
        },
        {
          "name": "keyword.operator.comparison.gleam",
          "match": "===|!==|==|!=|<=|>="
        },
        {
          "name": "keyword.operator.assignment.gleam",
          "match": "(?:\\+|-|\\*|/|%|&|\\||\\^|<<|>>|\\?\\?)?=(?![=>])|:="
        },
        {
          "name": "keyword.operator.logical.gleam",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.range.gleam",
          "match": "\\.\\.[.<=]?"
        },
        {
          "name": "keyword.operator.arithmetic.gleam",
          "match": "\\*\\*|\\+\\+|--|[-+*/%]"
        },
        {
          "name": "keyword.operator.bitwise.gleam",
          "match": "<<|>>|[&|^~]"
        },
        {
          "name": "keyword.operator.comparison.gleam",
          "match": "[<>]"
        },
        {
          "name": "keyword.operator.gleam",
          "match": "\\?|::|:|@"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.gleam"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.gleam"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.gleam",
          "match": ";"
        },
        {
          "name": "punctuation.separator.gleam",
          "match": ","
        },
        {
          "name": "punctuation.section.brackets.gleam",
          "match": "[()\\[\\]{}]"
        }
      ]
    }
  }
}
