{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HCL",
  "scopeName": "source.hcl",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#extra-0"
    },
    {
      "include": "#extra-1"
    },
    {
      "include": "#extra-2"
    },
    {
      "include": "#extra-3"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#type"
    },
    {
      "include": "#call"
    },
    {
      "include": "#member"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment-block": {
      "name": "comment.block.hcl",
      "begin": "/\\*",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.hcl"
        }
      },
      "end": "\\*/",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.hcl"
        }
      },
      "patterns": [
        {
          "include": "#todo"
        }
      ]
    },
    "todo": {
      "name": "keyword.other.todo.hcl",
      "match": "\\b(?:TODO|FIXME|HACK|NOTE|XXX|BUG)\\b"
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.block.documentation.hcl",
          "begin": "/\\*\\*(?!/)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.hcl"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.hcl"
            }
          },
          "patterns": [
            {
              "name": "keyword.other.documentation.hcl",
              "match": "@[A-Za-z]+"
            },
            {
              "include": "#todo"
            }
          ]
        },
        {
          "include": "#comment-block"
        },
        {
          "name": "comment.line.hcl",
          "begin": "#",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.hcl"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#todo"
            }
          ]
        },
        {
          "name": "comment.line.hcl",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.hcl"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#todo"
            }
          ]
        }
      ]
    },
    "extra-0": {
      "name": "string.unquoted.heredoc.hcl",
      "begin": "<<-?\\s*([A-Za-z_]\\w*)\\s*$",
      "end": "^\\s*\\1\\s*$"
    },
    "extra-1": {
      "match": "^\\s*([A-Za-z_][\\w-]*)((?:\\s+(?:\"[^\"]*\"|[A-Za-z_][\\w-]*))*)\\s*(?=\\{)",
      "captures": {
        "1": {
          "name": "storage.type.block.hcl"
        },
        "2": {
          "name": "entity.name.type.label.hcl"
        }
      }
    },
    "extra-2": {
      "match": "([A-Za-z_][\\w-]*)\\s*(=)(?!=)",
      "captures": {
        "1": {
          "name": "variable.other.property.hcl"
        },
        "2": {
          "name": "keyword.operator.assignment.hcl"
        }
      }
    },
    "extra-3": {
      "match": "\\b(var|local|module|data|each|count|path|terraform|self)(\\.)",
      "captures": {
        "1": {
          "name": "variable.language.hcl"
        },
        "2": {
          "name": "punctuation.accessor.hcl"
        }
      }
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.hcl",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.hcl"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.hcl"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.hcl",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            },
            {
              "name": "meta.embedded.interpolation.hcl",
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.hcl"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.hcl"
                }
              },
              "contentName": "source.embedded.hcl",
              "patterns": [
                {
                  "include": "#braces"
                },
                {
                  "include": "$self"
                }
              ]
            },
            {
              "name": "meta.embedded.interpolation.hcl",
              "begin": "%\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.hcl"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.hcl"
                }
              },
              "contentName": "source.embedded.hcl",
              "patterns": [
                {
                  "include": "#braces"
                },
                {
                  "include": "$self"
                }
              ]
            }
          ]
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.hcl",
          "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.binary.hcl",
          "match": "\\b0[bB][01][01_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.octal.hcl",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.hcl",
          "match": "(?:\\b\\d[\\d_]*\\.\\d[\\d_]*|\\B\\.\\d[\\d_]*)(?:[eE][+-]?\\d+)?(?:[fFdDhH]|f16|f32|f64)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d+(?:[fFdD])?\\b"
        },
        {
          "name": "constant.numeric.integer.hcl",
          "match": "\\b\\d[\\d_]*(?:[uUlLnfFdDiI]\\w*)?\\b"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.hcl",
          "match": "\\b(?:for|in|if|else|endif|endfor)\\b"
        },
        {
          "name": "constant.language.hcl",
          "match": "\\b(?:true|false|null)\\b"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "name": "support.type.hcl",
          "match": "\\b(?:string|number|bool|list|map|set|object|tuple|any)\\b"
        }
      ]
    },
    "call": {
      "match": "\\b([A-Za-z_][\\w!?]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.hcl"
        }
      }
    },
    "member": {
      "match": "(\\.)\\s*([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.hcl"
        },
        "2": {
          "name": "variable.other.property.hcl"
        }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.hcl",
          "match": "=>|->|<-|\\|>"
        },
        {
          "name": "keyword.operator.comparison.hcl",
          "match": "===|!==|==|!=|<=|>="
        },
        {
          "name": "keyword.operator.assignment.hcl",
          "match": "(?:\\+|-|\\*|/|%|&|\\||\\^|<<|>>|\\?\\?)?=(?![=>])|:="
        },
        {
          "name": "keyword.operator.logical.hcl",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.range.hcl",
          "match": "\\.\\.[.<=]?"
        },
        {
          "name": "keyword.operator.arithmetic.hcl",
          "match": "\\*\\*|\\+\\+|--|[-+*/%]"
        },
        {
          "name": "keyword.operator.bitwise.hcl",
          "match": "<<|>>|[&|^~]"
        },
        {
          "name": "keyword.operator.comparison.hcl",
          "match": "[<>]"
        },
        {
          "name": "keyword.operator.hcl",
          "match": "\\?|::|:|@"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.hcl"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.hcl"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.hcl",
          "match": ";"
        },
        {
          "name": "punctuation.separator.hcl",
          "match": ","
        },
        {
          "name": "punctuation.section.brackets.hcl",
          "match": "[()\\[\\]{}]"
        }
      ]
    }
  }
}
