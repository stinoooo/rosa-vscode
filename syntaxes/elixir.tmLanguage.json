{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Elixir",
  "scopeName": "source.elixir",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#extra-0"
    },
    {
      "include": "#extra-1"
    },
    {
      "include": "#extra-2"
    },
    {
      "include": "#extra-3"
    },
    {
      "include": "#extra-4"
    },
    {
      "include": "#string"
    },
    {
      "include": "#function-definition"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#builtin"
    },
    {
      "include": "#call"
    },
    {
      "include": "#member"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "todo": {
      "name": "keyword.other.todo.elixir",
      "match": "\\b(?:TODO|FIXME|HACK|NOTE|XXX|BUG)\\b"
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.line.elixir",
          "begin": "#",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.elixir"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#todo"
            }
          ]
        }
      ]
    },
    "extra-0": {
      "name": "constant.other.symbol.elixir",
      "match": "(?<![\\w:]):(?:[A-Za-z_][\\w@]*[?!]?|\"[^\"]*\")"
    },
    "extra-1": {
      "name": "constant.other.symbol.elixir",
      "match": "\\b[a-z_][\\w@]*[?!]?:(?=\\s)"
    },
    "extra-2": {
      "name": "meta.decorator.elixir entity.name.function.decorator.elixir",
      "match": "@[a-z_]\\w*"
    },
    "extra-3": {
      "name": "variable.language.elixir",
      "match": "\\b__(?:MODULE|DIR|ENV|CALLER|STACKTRACE)__\\b"
    },
    "extra-4": {
      "name": "entity.name.type.module.elixir",
      "match": "\\b[A-Z][\\w]*(?:\\.[A-Z]\\w*)*\\b"
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.triple.elixir",
          "begin": "\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.elixir"
            }
          },
          "end": "\"\"\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.elixir"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.elixir",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            },
            {
              "name": "meta.embedded.interpolation.elixir",
              "begin": "#\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.elixir"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.elixir"
                }
              },
              "contentName": "source.embedded.elixir",
              "patterns": [
                {
                  "include": "#braces"
                },
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.elixir",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.elixir"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.elixir"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.elixir",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            },
            {
              "name": "meta.embedded.interpolation.elixir",
              "begin": "#\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.elixir"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.elixir"
                }
              },
              "contentName": "source.embedded.elixir",
              "patterns": [
                {
                  "include": "#braces"
                },
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.triple.elixir",
          "begin": "'''",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.elixir"
            }
          },
          "end": "'''",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.elixir"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.elixir",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            },
            {
              "name": "meta.embedded.interpolation.elixir",
              "begin": "#\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.elixir"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.elixir"
                }
              },
              "contentName": "source.embedded.elixir",
              "patterns": [
                {
                  "include": "#braces"
                },
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.elixir",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.elixir"
            }
          },
          "end": "'|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.elixir"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.elixir",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            },
            {
              "name": "meta.embedded.interpolation.elixir",
              "begin": "#\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.elixir"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.elixir"
                }
              },
              "contentName": "source.embedded.elixir",
              "patterns": [
                {
                  "include": "#braces"
                },
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.regexp.elixir",
          "begin": "~[a-zA-Z]\\(",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.elixir"
            }
          },
          "end": "\\)[a-zA-Z]*",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.elixir"
            }
          },
          "patterns": []
        },
        {
          "name": "string.regexp.elixir",
          "begin": "~[a-zA-Z]\\[",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.elixir"
            }
          },
          "end": "\\][a-zA-Z]*",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.elixir"
            }
          },
          "patterns": []
        },
        {
          "name": "string.regexp.elixir",
          "begin": "~[a-zA-Z]\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.elixir"
            }
          },
          "end": "\\}[a-zA-Z]*",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.elixir"
            }
          },
          "patterns": []
        },
        {
          "name": "string.regexp.elixir",
          "begin": "~[a-zA-Z]/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.elixir"
            }
          },
          "end": "/[a-zA-Z]*",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.elixir"
            }
          },
          "patterns": []
        },
        {
          "name": "string.regexp.elixir",
          "begin": "~[a-zA-Z]\\|",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.elixir"
            }
          },
          "end": "\\|[a-zA-Z]*",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.elixir"
            }
          },
          "patterns": []
        },
        {
          "name": "string.regexp.elixir",
          "begin": "~[a-zA-Z]\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.elixir"
            }
          },
          "end": "\"[a-zA-Z]*",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.elixir"
            }
          },
          "patterns": []
        }
      ]
    },
    "function-definition": {
      "match": "\\b(def|defp|defmacro|defmacrop|defguard|defguardp|defdelegate)\\b\\s+(?:<[^>]*>\\s*)?(?:[A-Za-z_][\\w.]*\\.)?([A-Za-z_][\\w!?']*)",
      "captures": {
        "1": {
          "name": "storage.type.function.elixir"
        },
        "2": {
          "name": "entity.name.function.elixir"
        }
      }
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.elixir",
          "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.binary.elixir",
          "match": "\\b0[bB][01][01_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.octal.elixir",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.elixir",
          "match": "(?:\\b\\d[\\d_]*\\.\\d[\\d_]*|\\B\\.\\d[\\d_]*)(?:[eE][+-]?\\d+)?(?:[fFdDhH]|f16|f32|f64)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d+(?:[fFdD])?\\b"
        },
        {
          "name": "constant.numeric.integer.elixir",
          "match": "\\b\\d[\\d_]*(?:[uUlLnfFdDiI]\\w*)?\\b"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.elixir",
          "match": "\\b(?:if|unless|else|cond|case|with|for|try|catch|rescue|after|raise|reraise|throw|receive|send|do|end|fn|when|quote|unquote|unquote_splicing)\\b"
        },
        {
          "name": "storage.type.elixir",
          "match": "\\b(?:def|defp|defmacro|defmacrop|defmodule|defprotocol|defimpl|defstruct|defexception|defdelegate|defguard|defguardp|defoverridable|import|alias|require|use)\\b"
        },
        {
          "name": "keyword.operator.word.elixir",
          "match": "(?<![\\w.])(?:and|or|not|in)(?![\\w?])"
        },
        {
          "name": "constant.language.elixir",
          "match": "\\b(?:true|false|nil)\\b"
        }
      ]
    },
    "builtin": {
      "match": "\\b(spawn|spawn_link|self|is_atom|is_binary|is_list|is_map|is_integer|is_nil|elem|hd|tl|length|map_size|put_elem|inspect|to_string)\\b(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "support.function.builtin.elixir"
        }
      }
    },
    "call": {
      "match": "\\b([A-Za-z_][\\w!?]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.elixir"
        }
      }
    },
    "member": {
      "match": "(\\.)\\s*([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.elixir"
        },
        "2": {
          "name": "variable.other.property.elixir"
        }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.elixir",
          "match": "=>|->|<-|\\|>"
        },
        {
          "name": "keyword.operator.comparison.elixir",
          "match": "===|!==|==|!=|<=|>="
        },
        {
          "name": "keyword.operator.assignment.elixir",
          "match": "(?:\\+|-|\\*|/|%|&|\\||\\^|<<|>>|\\?\\?)?=(?![=>])|:="
        },
        {
          "name": "keyword.operator.logical.elixir",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.range.elixir",
          "match": "\\.\\.[.<=]?"
        },
        {
          "name": "keyword.operator.arithmetic.elixir",
          "match": "\\*\\*|\\+\\+|--|[-+*/%]"
        },
        {
          "name": "keyword.operator.bitwise.elixir",
          "match": "<<|>>|[&|^~]"
        },
        {
          "name": "keyword.operator.comparison.elixir",
          "match": "[<>]"
        },
        {
          "name": "keyword.operator.elixir",
          "match": "\\?|::|:|@"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.elixir"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.elixir"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.elixir",
          "match": ";"
        },
        {
          "name": "punctuation.separator.elixir",
          "match": ","
        },
        {
          "name": "punctuation.section.brackets.elixir",
          "match": "[()\\[\\]{}]"
        }
      ]
    }
  }
}
