{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GraphQL",
  "scopeName": "source.graphql",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#extra-0"
    },
    {
      "include": "#extra-1"
    },
    {
      "include": "#extra-2"
    },
    {
      "include": "#extra-3"
    },
    {
      "include": "#string"
    },
    {
      "include": "#function-definition"
    },
    {
      "include": "#type-definition"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#type"
    },
    {
      "include": "#constant-caps"
    },
    {
      "include": "#type-name"
    },
    {
      "include": "#member"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "todo": {
      "name": "keyword.other.todo.graphql",
      "match": "\\b(?:TODO|FIXME|HACK|NOTE|XXX|BUG)\\b"
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.line.graphql",
          "begin": "#",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.graphql"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#todo"
            }
          ]
        }
      ]
    },
    "extra-0": {
      "name": "variable.parameter.graphql",
      "match": "\\$[A-Za-z_]\\w*"
    },
    "extra-1": {
      "name": "meta.decorator.graphql entity.name.function.decorator.graphql",
      "match": "@[A-Za-z_]\\w*"
    },
    "extra-2": {
      "match": "\\b(on)\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "keyword.other.graphql"
        },
        "2": {
          "name": "entity.name.type.graphql"
        }
      }
    },
    "extra-3": {
      "match": "\\b([A-Za-z_]\\w*)\\s*(?=[:(])",
      "captures": {
        "1": {
          "name": "variable.other.property.graphql"
        }
      }
    },
    "string": {
      "patterns": [
        {
          "name": "comment.block.documentation.graphql",
          "begin": "\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.graphql"
            }
          },
          "end": "\"\"\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.graphql"
            }
          },
          "patterns": []
        },
        {
          "name": "string.quoted.double.graphql",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.graphql"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.graphql"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.graphql",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            }
          ]
        }
      ]
    },
    "function-definition": {
      "match": "\\b(query|mutation|subscription|fragment)\\b\\s+(?:<[^>]*>\\s*)?(?:[A-Za-z_][\\w.]*\\.)?([A-Za-z_][\\w!?']*)",
      "captures": {
        "1": {
          "name": "storage.type.function.graphql"
        },
        "2": {
          "name": "entity.name.function.graphql"
        }
      }
    },
    "type-definition": {
      "match": "\\b(type|interface|union|enum|input|scalar)\\b\\s+([A-Za-z_][\\w.]*)",
      "captures": {
        "1": {
          "name": "storage.type.graphql"
        },
        "2": {
          "name": "entity.name.type.graphql"
        }
      }
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.graphql",
          "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.binary.graphql",
          "match": "\\b0[bB][01][01_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.octal.graphql",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.graphql",
          "match": "(?:\\b\\d[\\d_]*\\.\\d[\\d_]*|\\B\\.\\d[\\d_]*)(?:[eE][+-]?\\d+)?(?:[fFdDhH]|f16|f32|f64)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d+(?:[fFdD])?\\b"
        },
        {
          "name": "constant.numeric.integer.graphql",
          "match": "\\b\\d[\\d_]*(?:[uUlLnfFdDiI]\\w*)?\\b"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "storage.type.graphql",
          "match": "\\b(?:query|mutation|subscription|fragment|type|interface|union|enum|input|scalar|schema|directive|extend|implements|repeatable)\\b"
        },
        {
          "name": "constant.language.graphql",
          "match": "\\b(?:true|false|null)\\b"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "name": "support.type.graphql",
          "match": "\\b(?:Int|Float|String|Boolean|ID)\\b"
        }
      ]
    },
    "constant-caps": {
      "name": "constant.other.caps.graphql",
      "match": "\\b[A-Z][A-Z0-9_]*[A-Z0-9]\\b(?![a-z(])"
    },
    "type-name": {
      "name": "entity.name.type.graphql",
      "match": "\\b[A-Z][A-Za-z0-9_]*[a-z][A-Za-z0-9_]*\\b"
    },
    "member": {
      "match": "(\\.)\\s*([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.graphql"
        },
        "2": {
          "name": "variable.other.property.graphql"
        }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.graphql",
          "match": "=>|->|<-|\\|>"
        },
        {
          "name": "keyword.operator.comparison.graphql",
          "match": "===|!==|==|!=|<=|>="
        },
        {
          "name": "keyword.operator.assignment.graphql",
          "match": "(?:\\+|-|\\*|/|%|&|\\||\\^|<<|>>|\\?\\?)?=(?![=>])|:="
        },
        {
          "name": "keyword.operator.logical.graphql",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.range.graphql",
          "match": "\\.\\.[.<=]?"
        },
        {
          "name": "keyword.operator.arithmetic.graphql",
          "match": "\\*\\*|\\+\\+|--|[-+*/%]"
        },
        {
          "name": "keyword.operator.bitwise.graphql",
          "match": "<<|>>|[&|^~]"
        },
        {
          "name": "keyword.operator.comparison.graphql",
          "match": "[<>]"
        },
        {
          "name": "keyword.operator.graphql",
          "match": "\\?|::|:|@"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.graphql"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.graphql"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.graphql",
          "match": ";"
        },
        {
          "name": "punctuation.separator.graphql",
          "match": ","
        },
        {
          "name": "punctuation.section.brackets.graphql",
          "match": "[()\\[\\]{}]"
        }
      ]
    }
  }
}
