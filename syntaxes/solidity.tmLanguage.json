{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Solidity",
  "scopeName": "source.solidity",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#extra-0"
    },
    {
      "include": "#string"
    },
    {
      "include": "#function-definition"
    },
    {
      "include": "#type-definition"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#type"
    },
    {
      "include": "#builtin"
    },
    {
      "include": "#constant-caps"
    },
    {
      "include": "#type-name"
    },
    {
      "include": "#call"
    },
    {
      "include": "#member"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment-block": {
      "name": "comment.block.solidity",
      "begin": "/\\*",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.solidity"
        }
      },
      "end": "\\*/",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.solidity"
        }
      },
      "patterns": [
        {
          "include": "#todo"
        }
      ]
    },
    "todo": {
      "name": "keyword.other.todo.solidity",
      "match": "\\b(?:TODO|FIXME|HACK|NOTE|XXX|BUG)\\b"
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.block.documentation.solidity",
          "begin": "/\\*\\*(?!/)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.solidity"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.solidity"
            }
          },
          "patterns": [
            {
              "name": "keyword.other.documentation.solidity",
              "match": "@[A-Za-z]+"
            },
            {
              "include": "#todo"
            }
          ]
        },
        {
          "include": "#comment-block"
        },
        {
          "name": "comment.line.solidity",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.solidity"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#todo"
            }
          ]
        }
      ]
    },
    "extra-0": {
      "name": "meta.preprocessor.pragma.solidity",
      "match": "\\bpragma\\b.*?(?=;)"
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.solidity",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.solidity"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.solidity"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.solidity",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            }
          ]
        },
        {
          "name": "string.quoted.single.solidity",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.solidity"
            }
          },
          "end": "'|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.solidity"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.solidity",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            }
          ]
        },
        {
          "name": "string.quoted.raw.solidity",
          "begin": "hex\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.solidity"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.solidity"
            }
          },
          "patterns": []
        },
        {
          "name": "string.quoted.double.solidity",
          "begin": "unicode\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.solidity"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.solidity"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.solidity",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            }
          ]
        }
      ]
    },
    "function-definition": {
      "match": "\\b(function|modifier|event|error)\\b\\s+(?:<[^>]*>\\s*)?(?:[A-Za-z_][\\w.]*\\.)?([A-Za-z_][\\w!?']*)",
      "captures": {
        "1": {
          "name": "storage.type.function.solidity"
        },
        "2": {
          "name": "entity.name.function.solidity"
        }
      }
    },
    "type-definition": {
      "match": "\\b(contract|interface|library|struct|enum)\\b\\s+([A-Za-z_][\\w.]*)",
      "captures": {
        "1": {
          "name": "storage.type.solidity"
        },
        "2": {
          "name": "entity.name.type.solidity"
        }
      }
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.solidity",
          "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.binary.solidity",
          "match": "\\b0[bB][01][01_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.octal.solidity",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.solidity",
          "match": "(?:\\b\\d[\\d_]*\\.\\d[\\d_]*|\\B\\.\\d[\\d_]*)(?:[eE][+-]?\\d+)?(?:[fFdDhH]|f16|f32|f64)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d+(?:[fFdD])?\\b"
        },
        {
          "name": "constant.numeric.integer.solidity",
          "match": "\\b\\d[\\d_]*(?:[uUlLnfFdDiI]\\w*)?\\b"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.solidity",
          "match": "\\b(?:if|else|for|while|do|break|continue|return|returns|try|catch|revert|require|assert|emit|unchecked|assembly|new|delete)\\b"
        },
        {
          "name": "storage.type.solidity",
          "match": "\\b(?:contract|interface|library|abstract|function|modifier|event|error|struct|enum|mapping|constructor|fallback|receive|import|using|is|type|let)\\b"
        },
        {
          "name": "storage.modifier.solidity",
          "match": "\\b(?:public|private|internal|external|pure|view|payable|virtual|override|constant|immutable|memory|storage|calldata|indexed|anonymous|transient)\\b"
        },
        {
          "name": "constant.language.solidity",
          "match": "\\b(?:true|false|wei|gwei|ether|seconds|minutes|hours|days|weeks)\\b"
        },
        {
          "name": "variable.language.solidity",
          "match": "\\b(?:this|super|msg|block|tx|abi)\\b"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "name": "support.type.solidity",
          "match": "\\b(?:address|bool|string|bytes|byte|int|uint|fixed|ufixed)\\b"
        },
        {
          "name": "support.type.solidity",
          "match": "\\b(?:u?int(?:8|16|24|32|40|48|56|64|72|80|88|96|104|112|120|128|136|144|152|160|168|176|184|192|200|208|216|224|232|240|248|256)|bytes(?:[1-9]|[12]\\d|3[0-2]))\\b"
        }
      ]
    },
    "builtin": {
      "match": "\\b(keccak256|sha256|ripemd160|ecrecover|addmod|mulmod|selfdestruct|blockhash|gasleft)\\b(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "support.function.builtin.solidity"
        }
      }
    },
    "constant-caps": {
      "name": "constant.other.caps.solidity",
      "match": "\\b[A-Z][A-Z0-9_]*[A-Z0-9]\\b(?![a-z(])"
    },
    "type-name": {
      "name": "entity.name.type.solidity",
      "match": "\\b[A-Z][A-Za-z0-9_]*[a-z][A-Za-z0-9_]*\\b"
    },
    "call": {
      "match": "\\b([A-Za-z_][\\w!?]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.solidity"
        }
      }
    },
    "member": {
      "match": "(\\.)\\s*([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.solidity"
        },
        "2": {
          "name": "variable.other.property.solidity"
        }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.solidity",
          "match": "=>|->|<-|\\|>"
        },
        {
          "name": "keyword.operator.comparison.solidity",
          "match": "===|!==|==|!=|<=|>="
        },
        {
          "name": "keyword.operator.assignment.solidity",
          "match": "(?:\\+|-|\\*|/|%|&|\\||\\^|<<|>>|\\?\\?)?=(?![=>])|:="
        },
        {
          "name": "keyword.operator.logical.solidity",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.range.solidity",
          "match": "\\.\\.[.<=]?"
        },
        {
          "name": "keyword.operator.arithmetic.solidity",
          "match": "\\*\\*|\\+\\+|--|[-+*/%]"
        },
        {
          "name": "keyword.operator.bitwise.solidity",
          "match": "<<|>>|[&|^~]"
        },
        {
          "name": "keyword.operator.comparison.solidity",
          "match": "[<>]"
        },
        {
          "name": "keyword.operator.solidity",
          "match": "\\?|::|:|@"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.solidity"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.solidity"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.solidity",
          "match": ";"
        },
        {
          "name": "punctuation.separator.solidity",
          "match": ","
        },
        {
          "name": "punctuation.section.brackets.solidity",
          "match": "[()\\[\\]{}]"
        }
      ]
    }
  }
}
