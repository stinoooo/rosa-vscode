{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Elm",
  "scopeName": "source.elm",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#extra-0"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#type"
    },
    {
      "include": "#constant-caps"
    },
    {
      "include": "#type-name"
    },
    {
      "include": "#member"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment-block": {
      "name": "comment.block.elm",
      "begin": "\\{-",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.elm"
        }
      },
      "end": "-\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.elm"
        }
      },
      "patterns": [
        {
          "include": "#todo"
        },
        {
          "include": "#comment-block"
        }
      ]
    },
    "todo": {
      "name": "keyword.other.todo.elm",
      "match": "\\b(?:TODO|FIXME|HACK|NOTE|XXX|BUG)\\b"
    },
    "comment": {
      "patterns": [
        {
          "include": "#comment-block"
        },
        {
          "name": "comment.line.elm",
          "begin": "--",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.elm"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#todo"
            }
          ]
        }
      ]
    },
    "extra-0": {
      "match": "^([a-z_]\\w*)\\s*(:)(?!:)",
      "captures": {
        "1": {
          "name": "entity.name.function.elm"
        },
        "2": {
          "name": "keyword.operator.elm"
        }
      }
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.triple.elm",
          "begin": "\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.elm"
            }
          },
          "end": "\"\"\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.elm"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.elm",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            }
          ]
        },
        {
          "name": "string.quoted.double.elm",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.elm"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.elm"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.elm",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            }
          ]
        },
        {
          "name": "string.quoted.single.elm",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.elm"
            }
          },
          "end": "'|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.elm"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.elm",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            }
          ]
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.elm",
          "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.binary.elm",
          "match": "\\b0[bB][01][01_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.octal.elm",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.elm",
          "match": "(?:\\b\\d[\\d_]*\\.\\d[\\d_]*|\\B\\.\\d[\\d_]*)(?:[eE][+-]?\\d+)?(?:[fFdDhH]|f16|f32|f64)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d+(?:[fFdD])?\\b"
        },
        {
          "name": "constant.numeric.integer.elm",
          "match": "\\b\\d[\\d_]*(?:[uUlLnfFdDiI]\\w*)?\\b"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.elm",
          "match": "\\b(?:if|then|else|case|of|let|in)\\b"
        },
        {
          "name": "storage.type.elm",
          "match": "\\b(?:module|import|exposing|as|type|alias|port|effect|where)\\b"
        },
        {
          "name": "constant.language.elm",
          "match": "\\b(?:True|False|Nothing)\\b"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "name": "support.type.elm",
          "match": "\\b(?:Int|Float|Bool|Char|String|List|Maybe|Result|Cmd|Sub|Html|Msg|Model)\\b"
        }
      ]
    },
    "constant-caps": {
      "name": "constant.other.caps.elm",
      "match": "\\b[A-Z][A-Z0-9_]*[A-Z0-9]\\b(?![a-z(])"
    },
    "type-name": {
      "name": "entity.name.type.elm",
      "match": "\\b[A-Z][A-Za-z0-9_]*[a-z][A-Za-z0-9_]*\\b"
    },
    "member": {
      "match": "(\\.)\\s*([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.elm"
        },
        "2": {
          "name": "variable.other.property.elm"
        }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.elm",
          "match": "=>|->|<-|\\|>"
        },
        {
          "name": "keyword.operator.comparison.elm",
          "match": "===|!==|==|!=|<=|>="
        },
        {
          "name": "keyword.operator.assignment.elm",
          "match": "(?:\\+|-|\\*|/|%|&|\\||\\^|<<|>>|\\?\\?)?=(?![=>])|:="
        },
        {
          "name": "keyword.operator.logical.elm",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.range.elm",
          "match": "\\.\\.[.<=]?"
        },
        {
          "name": "keyword.operator.arithmetic.elm",
          "match": "\\*\\*|\\+\\+|--|[-+*/%]"
        },
        {
          "name": "keyword.operator.bitwise.elm",
          "match": "<<|>>|[&|^~]"
        },
        {
          "name": "keyword.operator.comparison.elm",
          "match": "[<>]"
        },
        {
          "name": "keyword.operator.elm",
          "match": "\\?|::|:|@"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.elm"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.elm"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.elm",
          "match": ";"
        },
        {
          "name": "punctuation.separator.elm",
          "match": ","
        },
        {
          "name": "punctuation.section.brackets.elm",
          "match": "[()\\[\\]{}]"
        }
      ]
    }
  }
}
