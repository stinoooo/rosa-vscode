{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nim",
  "scopeName": "source.nim",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#annotation"
    },
    {
      "include": "#function-definition"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#type"
    },
    {
      "include": "#builtin"
    },
    {
      "include": "#constant-caps"
    },
    {
      "include": "#type-name"
    },
    {
      "include": "#call"
    },
    {
      "include": "#member"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment-block": {
      "name": "comment.block.nim",
      "begin": "#\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.nim"
        }
      },
      "end": "\\]#",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.nim"
        }
      },
      "patterns": [
        {
          "include": "#todo"
        },
        {
          "include": "#comment-block"
        }
      ]
    },
    "todo": {
      "name": "keyword.other.todo.nim",
      "match": "\\b(?:TODO|FIXME|HACK|NOTE|XXX|BUG)\\b"
    },
    "comment": {
      "patterns": [
        {
          "include": "#comment-block"
        },
        {
          "name": "comment.line.nim",
          "begin": "#(?![\\[\\]])",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.nim"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#todo"
            }
          ]
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.raw.nim",
          "begin": "[rR]?\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.nim"
            }
          },
          "end": "\"\"\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nim"
            }
          },
          "patterns": []
        },
        {
          "name": "string.quoted.raw.nim",
          "begin": "[rR]\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.nim"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nim"
            }
          },
          "patterns": []
        },
        {
          "name": "string.quoted.double.nim",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.nim"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nim"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.nim",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            }
          ]
        },
        {
          "name": "string.quoted.single.nim",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.nim"
            }
          },
          "end": "'|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nim"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.nim",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            }
          ]
        }
      ]
    },
    "annotation": {
      "name": "meta.decorator.nim",
      "match": "\\{\\..*?\\.\\}",
      "captures": {
        "0": {
          "name": "entity.name.function.decorator.nim"
        }
      }
    },
    "function-definition": {
      "match": "\\b(proc|func|method|iterator|template|macro|converter)\\b\\s+(?:<[^>]*>\\s*)?(?:[A-Za-z_][\\w.]*\\.)?([A-Za-z_][\\w!?']*)",
      "captures": {
        "1": {
          "name": "storage.type.function.nim"
        },
        "2": {
          "name": "entity.name.function.nim"
        }
      }
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.nim",
          "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.binary.nim",
          "match": "\\b0[bB][01][01_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.octal.nim",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.nim",
          "match": "(?:\\b\\d[\\d_]*\\.\\d[\\d_]*|\\B\\.\\d[\\d_]*)(?:[eE][+-]?\\d+)?(?:[fFdDhH]|f16|f32|f64)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d+(?:[fFdD])?\\b"
        },
        {
          "name": "constant.numeric.integer.nim",
          "match": "\\b\\d[\\d_]*(?:[uUlLnfFdDiI]\\w*)?\\b"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.nim",
          "match": "\\b(?:if|elif|else|when|case|of|for|while|block|break|continue|return|yield|try|except|finally|raise|defer|discard|asm|do)\\b"
        },
        {
          "name": "storage.type.nim",
          "match": "\\b(?:proc|func|method|iterator|template|macro|converter|type|var|let|const|object|tuple|enum|concept|distinct|import|include|from|export|using|static|bind|mixin|ref|ptr)\\b"
        },
        {
          "name": "keyword.operator.word.nim",
          "match": "(?<![\\w.])(?:and|or|not|xor|shl|shr|div|mod|in|notin|is|isnot|of|as|addr|cast)(?![\\w?])"
        },
        {
          "name": "constant.language.nim",
          "match": "\\b(?:true|false|nil)\\b"
        },
        {
          "name": "variable.language.nim",
          "match": "\\b(?:result)\\b"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "name": "support.type.nim",
          "match": "\\b(?:int|int8|int16|int32|int64|uint|uint8|uint16|uint32|uint64|float|float32|float64|bool|char|string|cstring|pointer|seq|array|openArray|set|range|auto|void|untyped|typed|Natural|Positive|Table|HashSet|Option)\\b"
        }
      ]
    },
    "builtin": {
      "match": "\\b(echo|len|high|low|inc|dec|add|del|newSeq|assert|doAssert|quit|ord|chr|repr|sizeof|new|items|pairs)\\b(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "support.function.builtin.nim"
        }
      }
    },
    "constant-caps": {
      "name": "constant.other.caps.nim",
      "match": "\\b[A-Z][A-Z0-9_]*[A-Z0-9]\\b(?![a-z(])"
    },
    "type-name": {
      "name": "entity.name.type.nim",
      "match": "\\b[A-Z][A-Za-z0-9_]*[a-z][A-Za-z0-9_]*\\b"
    },
    "call": {
      "match": "\\b([A-Za-z_][\\w!?]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.nim"
        }
      }
    },
    "member": {
      "match": "(\\.)\\s*([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.nim"
        },
        "2": {
          "name": "variable.other.property.nim"
        }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.nim",
          "match": "=>|->|<-|\\|>"
        },
        {
          "name": "keyword.operator.comparison.nim",
          "match": "===|!==|==|!=|<=|>="
        },
        {
          "name": "keyword.operator.assignment.nim",
          "match": "(?:\\+|-|\\*|/|%|&|\\||\\^|<<|>>|\\?\\?)?=(?![=>])|:="
        },
        {
          "name": "keyword.operator.logical.nim",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.range.nim",
          "match": "\\.\\.[.<=]?"
        },
        {
          "name": "keyword.operator.arithmetic.nim",
          "match": "\\*\\*|\\+\\+|--|[-+*/%]"
        },
        {
          "name": "keyword.operator.bitwise.nim",
          "match": "<<|>>|[&|^~]"
        },
        {
          "name": "keyword.operator.comparison.nim",
          "match": "[<>]"
        },
        {
          "name": "keyword.operator.nim",
          "match": "\\?|::|:|@"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.nim"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.nim"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.nim",
          "match": ";"
        },
        {
          "name": "punctuation.separator.nim",
          "match": ","
        },
        {
          "name": "punctuation.section.brackets.nim",
          "match": "[()\\[\\]{}]"
        }
      ]
    }
  }
}
