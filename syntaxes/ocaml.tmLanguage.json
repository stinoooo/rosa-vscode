{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "OCaml",
  "scopeName": "source.ocaml",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#extra-0"
    },
    {
      "include": "#extra-1"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#type"
    },
    {
      "include": "#builtin"
    },
    {
      "include": "#constant-caps"
    },
    {
      "include": "#type-name"
    },
    {
      "include": "#member"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment-block": {
      "name": "comment.block.ocaml",
      "begin": "\\(\\*",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.ocaml"
        }
      },
      "end": "\\*\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.ocaml"
        }
      },
      "patterns": [
        {
          "include": "#todo"
        },
        {
          "include": "#comment-block"
        }
      ]
    },
    "todo": {
      "name": "keyword.other.todo.ocaml",
      "match": "\\b(?:TODO|FIXME|HACK|NOTE|XXX|BUG)\\b"
    },
    "comment": {
      "patterns": [
        {
          "include": "#comment-block"
        }
      ]
    },
    "extra-0": {
      "match": "\\b(let|and)\\s+(?:(rec)\\s+)?([a-z_][\\w']*)",
      "captures": {
        "1": {
          "name": "storage.type.ocaml"
        },
        "2": {
          "name": "storage.modifier.ocaml"
        },
        "3": {
          "name": "entity.name.function.ocaml"
        }
      }
    },
    "extra-1": {
      "name": "meta.decorator.ocaml entity.name.function.decorator.ocaml",
      "match": "\\[@{1,3}[\\w.]+"
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.ocaml",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.ocaml"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.ocaml"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.ocaml",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            }
          ]
        },
        {
          "name": "string.quoted.raw.ocaml",
          "begin": "\\{([a-z_]*)\\|",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.ocaml"
            }
          },
          "end": "\\|\\1\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.ocaml"
            }
          },
          "patterns": []
        },
        {
          "name": "string.quoted.single.ocaml",
          "begin": "'(?=\\\\?.')",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.ocaml"
            }
          },
          "end": "'|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.ocaml"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.ocaml",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            }
          ]
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.ocaml",
          "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.binary.ocaml",
          "match": "\\b0[bB][01][01_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.octal.ocaml",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.ocaml",
          "match": "(?:\\b\\d[\\d_]*\\.\\d[\\d_]*|\\B\\.\\d[\\d_]*)(?:[eE][+-]?\\d+)?(?:[fFdDhH]|f16|f32|f64)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d+(?:[fFdD])?\\b"
        },
        {
          "name": "constant.numeric.integer.ocaml",
          "match": "\\b\\d[\\d_]*(?:[uUlLnfFdDiI]\\w*)?\\b"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.ocaml",
          "match": "\\b(?:if|then|else|match|with|function|fun|try|raise|for|to|downto|while|do|done|begin|end|when|assert|lazy)\\b"
        },
        {
          "name": "storage.type.ocaml",
          "match": "\\b(?:let|rec|and|in|type|module|struct|sig|functor|open|include|class|object|method|inherit|initializer|val|external|exception|constraint|nonrec|of)\\b"
        },
        {
          "name": "storage.modifier.ocaml",
          "match": "\\b(?:mutable|private|virtual)\\b"
        },
        {
          "name": "keyword.operator.word.ocaml",
          "match": "(?<![\\w.])(?:mod|land|lor|lxor|lsl|lsr|asr|not|or)(?![\\w?])"
        },
        {
          "name": "constant.language.ocaml",
          "match": "\\b(?:true|false|None|Some)\\b"
        },
        {
          "name": "variable.language.ocaml",
          "match": "\\b(?:self)\\b"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "name": "support.type.ocaml",
          "match": "\\b(?:int|float|bool|char|string|bytes|unit|list|array|option|result|ref|exn|int32|int64|nativeint)\\b"
        }
      ]
    },
    "builtin": {
      "match": "\\b(print_endline|print_string|print_int|print_newline|printf|failwith|invalid_arg|ignore|fst|snd|raise|compare)\\b(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "support.function.builtin.ocaml"
        }
      }
    },
    "constant-caps": {
      "name": "constant.other.caps.ocaml",
      "match": "\\b[A-Z][A-Z0-9_]*[A-Z0-9]\\b(?![a-z(])"
    },
    "type-name": {
      "name": "entity.name.type.ocaml",
      "match": "\\b[A-Z][A-Za-z0-9_]*[a-z][A-Za-z0-9_]*\\b"
    },
    "member": {
      "match": "(\\.)\\s*([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.ocaml"
        },
        "2": {
          "name": "variable.other.property.ocaml"
        }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.ocaml",
          "match": "=>|->|<-|\\|>"
        },
        {
          "name": "keyword.operator.comparison.ocaml",
          "match": "===|!==|==|!=|<=|>="
        },
        {
          "name": "keyword.operator.assignment.ocaml",
          "match": "(?:\\+|-|\\*|/|%|&|\\||\\^|<<|>>|\\?\\?)?=(?![=>])|:="
        },
        {
          "name": "keyword.operator.logical.ocaml",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.range.ocaml",
          "match": "\\.\\.[.<=]?"
        },
        {
          "name": "keyword.operator.arithmetic.ocaml",
          "match": "\\*\\*|\\+\\+|--|[-+*/%]"
        },
        {
          "name": "keyword.operator.bitwise.ocaml",
          "match": "<<|>>|[&|^~]"
        },
        {
          "name": "keyword.operator.comparison.ocaml",
          "match": "[<>]"
        },
        {
          "name": "keyword.operator.ocaml",
          "match": "\\?|::|:|@"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.ocaml"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.ocaml"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.ocaml",
          "match": ";"
        },
        {
          "name": "punctuation.separator.ocaml",
          "match": ","
        },
        {
          "name": "punctuation.section.brackets.ocaml",
          "match": "[()\\[\\]{}]"
        }
      ]
    }
  }
}
