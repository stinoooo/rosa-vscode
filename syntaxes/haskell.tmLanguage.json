{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Haskell",
  "scopeName": "source.haskell",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#extra-0"
    },
    {
      "include": "#extra-1"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#type"
    },
    {
      "include": "#builtin"
    },
    {
      "include": "#constant-caps"
    },
    {
      "include": "#type-name"
    },
    {
      "include": "#member"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment-block": {
      "name": "comment.block.haskell",
      "begin": "\\{-",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.haskell"
        }
      },
      "end": "-\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.haskell"
        }
      },
      "patterns": [
        {
          "include": "#todo"
        },
        {
          "include": "#comment-block"
        }
      ]
    },
    "todo": {
      "name": "keyword.other.todo.haskell",
      "match": "\\b(?:TODO|FIXME|HACK|NOTE|XXX|BUG)\\b"
    },
    "comment": {
      "patterns": [
        {
          "include": "#comment-block"
        },
        {
          "name": "comment.line.haskell",
          "begin": "--",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.haskell"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#todo"
            }
          ]
        }
      ]
    },
    "extra-0": {
      "name": "meta.preprocessor.pragma.haskell",
      "match": "\\{-#.*?#-\\}"
    },
    "extra-1": {
      "match": "^\\s*([a-z_][\\w']*)\\s*(::)",
      "captures": {
        "1": {
          "name": "entity.name.function.haskell"
        },
        "2": {
          "name": "keyword.operator.double-colon.haskell"
        }
      }
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.haskell",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.haskell"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.haskell"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.haskell",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            }
          ]
        },
        {
          "name": "string.quoted.single.haskell",
          "begin": "'(?=\\\\?.')",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.haskell"
            }
          },
          "end": "'|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.haskell"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.haskell",
              "match": "\\\\(?:[0-7]{1,3}|x[0-9A-Fa-f]{2}|u\\{?[0-9A-Fa-f]{1,6}\\}?|U[0-9A-Fa-f]{8}|.)"
            }
          ]
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.haskell",
          "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.binary.haskell",
          "match": "\\b0[bB][01][01_]*(?:[uUlLiI]\\w*)?\\b"
        },
        {
          "name": "constant.numeric.octal.haskell",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.haskell",
          "match": "(?:\\b\\d[\\d_]*\\.\\d[\\d_]*|\\B\\.\\d[\\d_]*)(?:[eE][+-]?\\d+)?(?:[fFdDhH]|f16|f32|f64)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d+(?:[fFdD])?\\b"
        },
        {
          "name": "constant.numeric.integer.haskell",
          "match": "\\b\\d[\\d_]*(?:[uUlLnfFdDiI]\\w*)?\\b"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.haskell",
          "match": "\\b(?:if|then|else|case|of|let|in|where|do|mdo|rec|proc)\\b"
        },
        {
          "name": "storage.type.haskell",
          "match": "\\b(?:module|import|qualified|as|hiding|data|newtype|type|class|instance|deriving|family|forall|pattern|default|via|stock|anyclass)\\b"
        },
        {
          "name": "storage.modifier.haskell",
          "match": "\\b(?:infix|infixl|infixr|foreign|export|ccall|safe|unsafe)\\b"
        },
        {
          "name": "constant.language.haskell",
          "match": "\\b(?:True|False|Nothing|otherwise|undefined)\\b"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "name": "support.type.haskell",
          "match": "\\b(?:Int|Integer|Double|Float|Bool|Char|String|Maybe|Either|IO|Word|Ordering|Text|ByteString)\\b"
        }
      ]
    },
    "builtin": {
      "match": "\\b(map|filter|foldr|foldl|putStrLn|print|show|read|return|pure|fmap|mapM_|mapM|sequence|concat|zip|head|tail|length|error|fst|snd|id|const|flip)\\b(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "support.function.builtin.haskell"
        }
      }
    },
    "constant-caps": {
      "name": "constant.other.caps.haskell",
      "match": "\\b[A-Z][A-Z0-9_]*[A-Z0-9]\\b(?![a-z(])"
    },
    "type-name": {
      "name": "entity.name.type.haskell",
      "match": "\\b[A-Z][A-Za-z0-9_]*[a-z][A-Za-z0-9_]*\\b"
    },
    "member": {
      "match": "(\\.)\\s*([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.haskell"
        },
        "2": {
          "name": "variable.other.property.haskell"
        }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.haskell",
          "match": "=>|->|<-|\\|>"
        },
        {
          "name": "keyword.operator.comparison.haskell",
          "match": "===|!==|==|!=|<=|>="
        },
        {
          "name": "keyword.operator.assignment.haskell",
          "match": "(?:\\+|-|\\*|/|%|&|\\||\\^|<<|>>|\\?\\?)?=(?![=>])|:="
        },
        {
          "name": "keyword.operator.logical.haskell",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.range.haskell",
          "match": "\\.\\.[.<=]?"
        },
        {
          "name": "keyword.operator.arithmetic.haskell",
          "match": "\\*\\*|\\+\\+|--|[-+*/%]"
        },
        {
          "name": "keyword.operator.bitwise.haskell",
          "match": "<<|>>|[&|^~]"
        },
        {
          "name": "keyword.operator.comparison.haskell",
          "match": "[<>]"
        },
        {
          "name": "keyword.operator.haskell",
          "match": "\\?|::|:|@"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.haskell"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.haskell"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.haskell",
          "match": ";"
        },
        {
          "name": "punctuation.separator.haskell",
          "match": ","
        },
        {
          "name": "punctuation.section.brackets.haskell",
          "match": "[()\\[\\]{}]"
        }
      ]
    }
  }
}
