          "cmake"
        ],
        "extensions": [
          ".cmake"
        ],
        "filenames": [
          "CMakeLists.txt",
          "CMakeCache.txt"
        ],
        "configuration": "./languages/cmake.json"
      },
      {
        "id": "toml",
        "aliases": [
