    "titleBar.inactiveBackground": "#efe6dc",
    "titleBar.inactiveForeground": "#6b584b",
    "titleBar.border": "#e2d6ca",
    "statusBar.background": "#4a5c3d",
    "statusBar.foreground": "#f5ede5",
    "statusBar.border": "#4a5c3d",
    "statusBar.noFolderBackground": "#4a5c3d",
    "statusBar.debuggingBackground": "#8a4a24",
    "statusBar.debuggingForeground": "#f5ede5",
    "statusBarItem.hoverBackground": "#ffffff1f",
    "statusBarItem.remoteBackground": "#f5ede5",
    "statusBarItem.remoteForeground": "#4a5c3d",
    "panel.background": "#efe6dc",
    "panel.border": "#e2d6ca",
