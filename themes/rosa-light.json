    "terminal.background": "#efe6dc",
    "terminal.foreground": "#3b2a1f",
    "terminalCursor.foreground": "#556232",
    "terminal.selectionBackground": "#55623233",
    "terminal.ansiBlack": "#3b2a1f",
    "terminal.ansiRed": "#a03d3d",
    "terminal.ansiGreen": "#3f6e3c",
    "terminal.ansiYellow": "#7d5f0c",
    "terminal.ansiBlue": "#3d6976",
    "terminal.ansiMagenta": "#8c4a4a",
    "terminal.ansiCyan": "#2f6b63",
    "terminal.ansiWhite": "#6b584b",
    "terminal.ansiBrightBlack": "#715e51",
    "terminal.ansiBrightRed": "#8c4a4a",
    "terminal.ansiBrightGreen": "#556232",
    "terminal.ansiBrightYellow": "#8a6a12",
    "terminal.ansiBrightBlue": "#2f5560",
    "terminal.ansiBrightMagenta": "#7a3f55",
    "terminal.ansiBrightCyan": "#245750",
    "terminal.ansiBrightWhite": "#3b2a1f",
    "input.background": "#f9f4ee",
    "input.foreground": "#3b2a1f",
    "input.border": "#cdbcae",
    "input.placeholderForeground": "#715e51",
    "inputOption.activeBorder": "#6b7a4a",
    "inputOption.activeBackground": "#5562321f",
    "inputValidation.errorBorder": "#a03d3d",
    "inputValidation.warningBorder": "#c2703f",
    "inputValidation.infoBorder": "#3d6976",
    "dropdown.background": "#f9f4ee",
    "dropdown.foreground": "#3b2a1f",
    "dropdown.border": "#cdbcae",
    "checkbox.background": "#f9f4ee",
    "checkbox.border": "#cdbcae",
    "button.background": "#556232",
    "button.foreground": "#f5ede5",
    "button.hoverBackground": "#4a5c3d",
    "button.secondaryBackground": "#fbf7f2",
    "button.secondaryForeground": "#3b2a1f",
    "button.secondaryHoverBackground": "#e8dcd0",
    "badge.background": "#556232",
    "badge.foreground": "#f5ede5",
    "progressBar.background": "#556232",
    "quickInput.background": "#f9f4ee",
    "quickInput.foreground": "#3b2a1f",
    "quickInputList.focusBackground": "#e8dcd0",
    "pickerGroup.foreground": "#556232",
    "pickerGroup.border": "#e2d6ca",
    "menu.background": "#f9f4ee",
    "menu.foreground": "#3b2a1f",
    "menu.selectionBackground": "#e8dcd0",
    "menu.selectionForeground": "#3b2a1f",
    "menu.separatorBackground": "#e2d6ca",
    "menu.border": "#cdbcae",
    "notifications.background": "#f9f4ee",
    "notifications.foreground": "#3b2a1f",
    "notifications.border": "#cdbcae",
    "notificationCenterHeader.background": "#fbf7f2",
    "gitDecoration.addedResourceForeground": "#3f6e3c",
    "gitDecoration.untrackedResourceForeground": "#3f6e3c",
    "gitDecoration.modifiedResourceForeground": "#3d6976",
    "gitDecoration.deletedResourceForeground": "#a03d3d",
    "gitDecoration.conflictingResourceForeground": "#c2703f",
    "gitDecoration.ignoredResourceForeground": "#715e51",
    "breadcrumb.foreground": "#6b584b",
    "breadcrumb.focusForeground": "#3b2a1f",
    "breadcrumb.activeSelectionForeground": "#3b2a1f",
    "breadcrumbPicker.background": "#f9f4ee"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#715e51",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#8c4a4a"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#6b584b"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#6b584b"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#556232"
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#3d6976"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#8f4a20"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#7d5f0c"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#3d6976"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#3b2a1f"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#8a4a24",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Language variables",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#8c4a4a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#665d48"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#8c4a4a"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7d5f0c"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#665d48"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#8a4a24"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#4a5c3d",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#3b2a1f",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#3b2a1f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#8f4a20"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#3d6976"
      }
    },
    {
      "name": "Markdown quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#6b584b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#3f6e3c"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#a03d3d"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#3d6976"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#665d48"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#a03d3d"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#3d6976",
    "type": "#3d6976",
    "class": "#3d6976",
    "interface": "#3d6976",
    "enum": "#3d6976",
    "typeParameter": {
      "foreground": "#3d6976",
      "italic": true
    },
    "function": "#7d5f0c",
    "method": "#7d5f0c",
    "decorator": "#8a4a24",
    "macro": "#7d5f0c",
    "variable": "#3b2a1f",
    "variable.readonly": "#3b2a1f",
    "variable.defaultLibrary": "#8f4a20",
    "parameter": {
      "foreground": "#8a4a24",
      "italic": true
    },
    "property": "#665d48",
    "enumMember": "#8f4a20",
    "event": "#665d48",
    "keyword": "#8c4a4a",
    "string": "#556232",
    "number": "#8f4a20",
    "regexp": "#3d6976",
    "comment": {
      "foreground": "#715e51",
      "italic": true
    }
  }
}
