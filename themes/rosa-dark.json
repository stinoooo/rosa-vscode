    "statusBar.noFolderBackground": "#12100d",
    "statusBar.debuggingBackground": "#3a2a1c",
    "statusBar.debuggingForeground": "#e8b287",
    "statusBarItem.hoverBackground": "#ffffff14",
    "statusBarItem.remoteBackground": "#a8bd7f",
