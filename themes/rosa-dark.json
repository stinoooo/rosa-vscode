    "titleBar.activeForeground": "#e6dbcd",
    "titleBar.inactiveBackground": "#16110d",
    "titleBar.inactiveForeground": "#b8aa9b",
    "titleBar.border": "#2e261f",
    "statusBar.background": "#12100d",
    "statusBar.foreground": "#b8aa9b",
