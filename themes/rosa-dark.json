    "terminal.ansiBlue": "#7fb8c9",
    "terminal.ansiMagenta": "#dd9b9b",
    "terminal.ansiCyan": "#8fc4b8",
    "terminal.ansiWhite": "#b8aa9b",
    "terminal.ansiBrightBlack": "#8f8375",
    "terminal.ansiBrightRed": "#f0a8a8",
    "terminal.ansiBrightGreen": "#a8bd7f",
    "terminal.ansiBrightYellow": "#e8c96a",
    "terminal.ansiBrightBlue": "#a3d0dd",
    "terminal.ansiBrightMagenta": "#e8b5b5",
    "terminal.ansiBrightCyan": "#b0dad0",
    "terminal.ansiBrightWhite": "#e6dbcd",
    "input.background": "#1f1914",
    "input.foreground": "#e6dbcd",
    "input.border": "#433930",
    "input.placeholderForeground": "#8f8375",
    "inputOption.activeBorder": "#93a86a",
    "inputOption.activeBackground": "#a8bd7f1f",
    "inputValidation.errorBorder": "#e58b8b",
    "inputValidation.warningBorder": "#e3a06d",
    "inputValidation.infoBorder": "#7fb8c9",
    "dropdown.background": "#1f1914",
    "dropdown.foreground": "#e6dbcd",
    "dropdown.border": "#433930",
    "checkbox.background": "#1f1914",
    "checkbox.border": "#433930",
    "button.background": "#a8bd7f",
    "button.foreground": "#191410",
    "button.hoverBackground": "#a9c08c",
    "button.secondaryBackground": "#241d17",
    "button.secondaryForeground": "#e6dbcd",
    "button.secondaryHoverBackground": "#2b231c",
    "badge.background": "#a8bd7f",
    "badge.foreground": "#191410",
    "progressBar.background": "#a8bd7f",
    "quickInput.background": "#1f1914",
    "quickInput.foreground": "#e6dbcd",
    "quickInputList.focusBackground": "#2b231c",
    "pickerGroup.foreground": "#a8bd7f",
    "pickerGroup.border": "#2e261f",
    "menu.background": "#1f1914",
    "menu.foreground": "#e6dbcd",
    "menu.selectionBackground": "#2b231c",
    "menu.selectionForeground": "#e6dbcd",
    "menu.separatorBackground": "#2e261f",
    "menu.border": "#433930",
    "notifications.background": "#1f1914",
    "notifications.foreground": "#e6dbcd",
    "notifications.border": "#433930",
    "notificationCenterHeader.background": "#241d17",
    "gitDecoration.addedResourceForeground": "#7fb873",
    "gitDecoration.untrackedResourceForeground": "#7fb873",
    "gitDecoration.modifiedResourceForeground": "#7fb8c9",
    "gitDecoration.deletedResourceForeground": "#e58b8b",
    "gitDecoration.conflictingResourceForeground": "#e3a06d",
    "gitDecoration.ignoredResourceForeground": "#8f8375",
    "breadcrumb.foreground": "#b8aa9b",
    "breadcrumb.focusForeground": "#e6dbcd",
    "breadcrumb.activeSelectionForeground": "#e6dbcd",
    "breadcrumbPicker.background": "#1f1914"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8f8375",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#dd9b9b"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#b8aa9b"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#b8aa9b"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a8bd7f"
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#7fb8c9"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#e0a06f"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#d9b64a"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#7fb8c9"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#e6dbcd"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#e8b287",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Language variables",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#dd9b9b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#c4b898"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#dd9b9b"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#d9b64a"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#c4b898"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#e8b287"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#a9c08c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#e6dbcd",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#e6dbcd",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#e0a06f"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#7fb8c9"
      }
    },
    {
      "name": "Markdown quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#b8aa9b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#7fb873"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#e58b8b"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#7fb8c9"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#c4b898"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e58b8b"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#7fb8c9",
    "type": "#7fb8c9",
    "class": "#7fb8c9",
    "interface": "#7fb8c9",
    "enum": "#7fb8c9",
    "typeParameter": {
      "foreground": "#7fb8c9",
      "italic": true
    },
    "function": "#d9b64a",
    "method": "#d9b64a",
    "decorator": "#e8b287",
    "macro": "#d9b64a",
    "variable": "#e6dbcd",
    "variable.readonly": "#e6dbcd",
    "variable.defaultLibrary": "#e0a06f",
    "parameter": {
      "foreground": "#e8b287",
      "italic": true
    },
    "property": "#c4b898",
    "enumMember": "#e0a06f",
    "event": "#c4b898",
    "keyword": "#dd9b9b",
    "string": "#a8bd7f",
    "number": "#e0a06f",
    "regexp": "#7fb8c9",
    "comment": {
      "foreground": "#8f8375",
      "italic": true
    }
  }
}
